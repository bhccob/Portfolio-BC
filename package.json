{
  "name": "portfolio-bob",
  "version": "2.0.0",
  "description": "Bob Chung's personal portfolio: Astro + TypeScript, a C/WebAssembly physics hero and a Python deploy auditor.",
  "type": "module",
  "private": true,
  "author": "Bob Chung",
  "scripts": {
    "build:wasm": "node native/build.mjs",
    "build:og": "node tools/og-image.mjs",
    "predev": "npm run build:wasm",
    "dev": "astro dev",
    "prebuild": "npm run build:wasm && npm run build:og",
    "build": "astro build",
    "preview": "astro preview",
    "pretest": "npm run build:wasm",
    "test": "node --test tests/*.test.mjs",
    "audit": "python tools/site_audit.py dist"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@fontsource-variable/sofia-sans": "5.3.0",
    "@fontsource-variable/sofia-sans-extra-condensed": "5.3.0",
    "@fontsource/bagel-fat-one": "5.3.0",
    "@fontsource/yellowtail": "5.3.0",
    "astro": "7.3.8",
    "gsap": "3.15.0",
    "lenis": "1.3.26"
  },
  "devDependencies": {
    "@yowasp/clang": "22.0.0-git20542-10"
  }
}
