{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // Lets tests import the JSDoc-typed build tools (tools/build/*.mjs); they are not checked.
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "rootDirs": [".", "./.react-router/types"],
    "paths": { "~/*": ["./src/*"] }
  },
  "include": [
    "src",
    "tests",
    "tools/**/*.ts",
    ".react-router/types/**/*",
    "react-router.config.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
