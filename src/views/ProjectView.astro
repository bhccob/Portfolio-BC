---
import { Picture, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import FlapText from '../components/ui/FlapText.astro';
import LineObjects from '../components/ui/LineObjects.astro';
import { Translator, type Locale } from '../i18n/Translator';
import { projects, type Project } from '../data/projects';

interface Props {
  locale: Locale;
  project: Project;
}

const { locale, project } = Astro.props;
const i18n = new Translator(locale);
const { t } = i18n;
const copy = project.copy(locale);
const next = projects.next(project);
const nextCopy = next.copy(locale);
const site = Astro.site!;
const cover = await getImage({ src: project.image, width: 1200, format: 'webp' });
const home = i18n.path('/');

const sourceCode = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: project.title,
  description: copy.summary,
  url: new URL(i18n.path(project.route()), site).href,
  codeRepository: project.repo,
  programmingLanguage: project.stack,
  dateCreated: String(project.year),
  image: new URL(cover.src, site).href,
  inLanguage: locale,
  author: { '@id': `${site.origin}/#person` }
};

const facts = [
  { label: t.work.line, value: `${project.line} · ${copy.area}` },
  { label: t.work.type, value: copy.type },
  { label: t.work.year, value: String(project.year) },
  { label: t.work.role, value: copy.role },
  { label: t.work.stack, value: project.stack.join(' · ') }
];

const sections = [
  { title: t.project.overview, text: copy.overview },
  { title: t.project.build, text: copy.build },
  { title: t.project.focus, text: copy.focus }
];
---

<BaseLayout
  locale={locale}
  route={project.route()}
  title={`${project.title} | ${copy.type.split(' · ')[0]} | Bob Chung`}
  description={copy.metaDescription}
  ogType="article"
  structuredData={[sourceCode]}
  page="project"
>
  <article class="case" aria-labelledby="case-title">
    <LineObjects
      items={project.line === 'GD'
        ? [
            { icon: 'controller', x: 84, y: 7, size: 76, speed: 0.2, rotate: 12, accent: true }
          ]
        : [
            { icon: 'sine', x: 80, y: 8, size: 80, speed: 0.2, accent: true, note: 'f(t)' }
          ]}
    />
    <div class="container">
      <div class="board-line">
        <a class="case__back" href={`${home}#work`}>
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 8H3M7 4L3 8l4 4" /></svg>
          {t.project.back}
        </a>
        <p class="board-line__code"><b>{t.work.project} {project.label}</b><span>{t.board.departed}</span></p>
      </div>

      <header class="case__head">
        <FlapText text={project.label} label="" play="intro" class="case__num" />
        <div class="case__intro">
          <h1 id="case-title" class="display case__title" data-split>{project.title}</h1>
          <p class="lead" data-reveal>{copy.summary}</p>
        </div>
      </header>

      <dl class="case__facts" data-reveal>
        {
          facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
        <div>
          <dt>GitHub</dt>
          <dd><a class="text-link" href={project.repo} target="_blank" rel="noopener noreferrer">{project.repoPath}</a></dd>
        </div>
      </dl>

      <figure class="case__shot" data-shot>
        <span class="case__bar" aria-hidden="true">
          <span>{project.repoPath}</span>
          <span>{project.label} · {project.year}</span>
        </span>
        <span class="case__frame">
          <Picture
            src={project.image}
            formats={['avif', 'webp']}
            widths={[640, 1024, 1600, 2200]}
            sizes="(max-width: 1400px) 92vw, 1300px"
            alt={copy.imageAlt}
            loading="eager"
            fetchpriority="high"
          />
        </span>
        <span class="case__dim" aria-hidden="true"><span>{project.image.width} × {project.image.height} px</span></span>
      </figure>

      <div class="case__sections">
        {
          sections.map((section) => (
            <section class="case__section" data-reveal>
              <h2 class="case__section-title">{section.title}</h2>
              <p>{section.text}</p>
            </section>
          ))
        }
      </div>

      <div class="case__actions" data-reveal>
        <a class="btn" href={project.repo} target="_blank" rel="noopener noreferrer">
          {t.work.github}
          <svg class="icon" viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12L12 4M5.5 4H12v6.5" /></svg>
        </a>
      </div>

      <nav class="case__next" aria-label={t.project.next}>
        <a class="next-row" href={i18n.path(next.route())} data-flap-host>
          <span class="next-row__label">{t.project.next} · {next.label}</span>
          <FlapText text={next.title} label={next.title} hover wrap class="next-row__title" />
          <span class="next-row__type">{nextCopy.type}</span>
        </a>
        <div class="case__more">
          <p class="h3" set:html={t.project.moreTitle} />
          <p class="body-text">{t.project.moreText}</p>
          <a class="text-link" href={`${home}#work`}>{t.project.moreLink}</a>
        </div>
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .case {
    position: relative;
    padding: calc(var(--header-h) + clamp(32px, 5vw, 64px)) 0 var(--section-y);
  }

  .case .container {
    position: relative;
    z-index: 1;
  }

  .case__back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 450 12px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lilac);
    transition: color 0.3s;
  }

  .case__back:hover {
    color: var(--yellow);
  }

  .case__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 24px clamp(28px, 5vw, 72px);
    align-items: start;
  }

  .case :global(.case__num) {
    --tw: 0.78;
    --th: 1.1;
    --gap: 0.06em;
    font-size: clamp(64px, 9vw, 140px);
  }

  .case__intro {
    display: grid;
    gap: 24px;
  }

  .case__title {
    font-size: clamp(60px, 9vw, 132px);
  }

  .case__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 0 28px;
    margin-top: clamp(40px, 5vw, 64px);
  }

  .case__facts div {
    display: grid;
    gap: 6px;
    padding: 16px 0;
    background: linear-gradient(var(--line-strong), var(--line-strong)) left top / 100% 1px no-repeat;
  }

  .case__facts dt {
    font: 450 11px/1.4 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .case__facts dd {
    font-size: 16px;
  }

  .case__shot {
    margin-top: clamp(40px, 5vw, 72px);
  }

  .case__bar {
    display: flex;
    justify-content: space-between;
    padding-bottom: 10px;
    font: 450 11px/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .case__frame {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--board-3);
    box-shadow: 0 50px 80px -50px rgb(0 0 0 / 0.8);
  }

  .case__frame :global(img) {
    width: 100%;
  }

  .case__dim {
    position: relative;
    display: block;
    height: 12px;
    margin-top: 12px;
    background: linear-gradient(rgb(255 207 51 / 0.4), rgb(255 207 51 / 0.4)) left center / 100% 1px no-repeat;
  }

  .case__dim::before,
  .case__dim::after {
    content: '';
    position: absolute;
    top: 0;
    width: 1px;
    height: 100%;
    background: rgb(255 207 51 / 0.5);
  }

  .case__dim::before {
    left: 0;
  }

  .case__dim::after {
    right: 0;
  }

  .case__dim span {
    position: absolute;
    left: 50%;
    top: -2px;
    transform: translateX(-50%);
    padding: 0 10px;
    background: var(--board);
    font: 450 11px/1.4 var(--font-mono);
    letter-spacing: 0.1em;
    color: rgb(255 207 51 / 0.75);
  }

  .case__sections {
    display: grid;
    margin-top: clamp(56px, 7vw, 96px);
  }

  .case__section {
    display: grid;
    grid-template-columns: minmax(180px, 0.35fr) minmax(0, 1fr);
    gap: 16px 48px;
    padding: 28px 0;
    background: linear-gradient(var(--line), var(--line)) left top / 100% 1px no-repeat;
  }

  .case__section-title {
    font: 800 28px/1 var(--font-flap);
    text-transform: uppercase;
    color: var(--yellow);
  }

  .case__section p {
    max-width: 40em;
    color: var(--lilac);
  }

  .case__actions {
    margin-top: 40px;
  }

  .case__next {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: 40px clamp(40px, 6vw, 96px);
    margin-top: clamp(80px, 10vw, 140px);
    padding-top: 32px;
    background: linear-gradient(var(--line-strong), var(--line-strong)) left top / 100% 1px no-repeat;
  }

  .next-row {
    display: grid;
    gap: 16px;
    justify-items: start;
  }

  .next-row__label {
    font: 450 11px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .next-row :global(.next-row__title) {
    --tw: 0.8;
    --th: 1.14;
    --gap: 0.07em;
    font-size: clamp(40px, 5vw, 72px);
  }

  .next-row__type {
    color: var(--lilac);
  }

  .case__more {
    display: grid;
    gap: 14px;
    justify-items: start;
    align-content: start;
  }

  @media (max-width: 900px) {
    .case__head,
    .case__section,
    .case__next {
      grid-template-columns: 1fr;
    }
  }
</style>
