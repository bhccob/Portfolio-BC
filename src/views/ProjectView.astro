---
import { Picture, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import FlapText from '../components/ui/FlapText.astro';
import Icon from '../components/ui/Icon.astro';
import LineObjects from '../components/ui/LineObjects.astro';
import { Translator, type Locale } from '../i18n/Translator';
import { categories, type Category } from '../data/categories';
import { projects, type Project } from '../data/projects';

interface Props {
  locale: Locale;
  /** The category shelf the visitor is browsing. */
  category: Category;
  project: Project;
}

const { locale, category, project } = Astro.props;
const i18n = new Translator(locale);
const { t } = i18n;
const copy = project.copy(locale);
const categoryCopy = category.copy(locale);
const site = Astro.site!;
const home = i18n.path('/');

// The shelf: every project in this category, and where this one sits on it.
const shelf = projects.inCategory(category);
const index = shelf.indexOf(project);
const browsable = shelf.length > 1;
const previous = shelf[(index - 1 + shelf.length) % shelf.length];
const next = shelf[(index + 1) % shelf.length];
const route = projects.route(project, category);
// A project listed in a second category is indexed at its home category's address.
const canonicalRoute = project.primaryCategory === category ? undefined : projects.route(project);
const otherCategories = categories.all().filter((other) => other !== category);
const count = (total: number) => (total === 1 ? t.work.countOne : i18n.format(t.work.countMany, { n: total }));

const cover = await getImage({ src: project.image, width: 1200, format: 'webp' });
const ogImage = `/og/${locale}/${project.slug}.png`;

const sourceCode = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: project.title,
  description: copy.summary,
  url: new URL(i18n.path(projects.route(project)), site).href,
  codeRepository: project.repo,
  programmingLanguage: project.stack,
  dateCreated: String(project.year),
  image: new URL(cover.src, site).href,
  inLanguage: locale,
  author: { '@id': `${site.origin}/#person` }
};

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Bob Chung', item: new URL(home, site).href },
    { '@type': 'ListItem', position: 2, name: categoryCopy.title, item: new URL(i18n.path(category.route()), site).href },
    { '@type': 'ListItem', position: 3, name: project.title, item: new URL(i18n.path(route), site).href }
  ]
};

const facts = [
  { label: t.work.category, value: copy.category },
  { label: t.work.type, value: copy.type },
  { label: t.work.year, value: String(project.year) },
  { label: t.work.role, value: copy.role },
  { label: t.work.stack, value: project.stack.join(' · ') }
];

const sections = [
  { title: t.project.overview, text: copy.overview },
  { title: t.project.build, text: copy.build },
  { title: t.project.focus, text: copy.focus }
];
---

<BaseLayout
  locale={locale}
  route={route}
  canonicalRoute={canonicalRoute}
  title={`${project.title} | ${categoryCopy.title} | Bob Chung`}
  description={copy.metaDescription}
  ogType="article"
  ogImage={ogImage}
  ogImageAlt={`${project.title}: ${copy.category}`}
  structuredData={[sourceCode, breadcrumbs]}
  page="project"
>
  <article class="case" aria-labelledby="case-title">
    <LineObjects
      items={category.id === 'game-development'
        ? [{ icon: 'controller', x: 62, y: 9, size: 76, speed: 0.2, rotate: 12, accent: true }]
        : [{ icon: 'sine', x: 62, y: 9, size: 80, speed: 0.2, accent: true, note: 'f(t)' }]}
    />
    <div class="container">
      <div class="board-line">
        <a class="case__back" href={`${home}#work`}>
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 8H3M7 4L3 8l4 4" /></svg>
          {t.project.back}
        </a>
        <p class="board-line__code"><b>{count(shelf.length)}</b></p>
      </div>

      <nav class="shelf" aria-label={i18n.format(t.project.shelf, { category: categoryCopy.title })} data-shelf>
        <p class="shelf__title">
          <span class="shelf__icon" aria-hidden="true"><Icon name={category.icon} size={24} strokeWidth={1.6} /></span>
          {categoryCopy.title}
        </p>
        <p class="shelf__intro">{categoryCopy.intro}</p>
        <ul class="shelf__tabs">
          {
            shelf.map((item) => (
              <li>
                <a class="shelf__tab" href={i18n.path(projects.route(item, category))} aria-current={item === project ? 'page' : undefined}>
                  <span class="shelf__tab-meta">{item.label} · {item.year}</span>
                  <span class="shelf__tab-name">{item.title}</span>
                </a>
              </li>
            ))
          }
        </ul>
        {
          browsable && (
            <div class="shelf__step">
              <a class="shelf__arrow" href={i18n.path(projects.route(previous, category))} rel="prev" data-switch-prev>
                <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 8H3M7 4L3 8l4 4" /></svg>
                <span class="visually-hidden">{t.project.previous}: {previous.title}</span>
              </a>
              <a class="shelf__arrow" href={i18n.path(projects.route(next, category))} rel="next" data-switch-next>
                <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" /></svg>
                <span class="visually-hidden">{t.project.next}: {next.title}</span>
              </a>
              <span class="shelf__keys">{t.project.keys}</span>
            </div>
          )
        }
      </nav>

      <header class="case__head">
        <h1 id="case-title" class="display case__title" data-split>{project.title}</h1>
        <p class="lead" data-reveal>{copy.summary}</p>
      </header>


      <figure class="case__shot" data-shot>
        <span class="case__bar" aria-hidden="true">
          <span>{project.repoPath}</span>
          <span>{project.label} · {project.year}</span>
        </span>
        <span class="case__frame">
          <Picture
            src={project.image}
            formats={['avif', 'webp']}
            widths={[640, 1024, 1600, 2200]}
            sizes="(max-width: 1400px) 92vw, 1300px"
            alt={copy.imageAlt}
            loading="eager"
            fetchpriority="high"
          />
        </span>
        <span class="case__dim" aria-hidden="true"><span>{project.image.width} × {project.image.height} px</span></span>
      </figure>

      <dl class="case__facts" data-reveal>
        {
          facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
        <div>
          <dt>GitHub</dt>
          <dd><a class="text-link" href={project.repo} target="_blank" rel="noopener noreferrer">{project.repoPath}</a></dd>
        </div>
      </dl>

      <div class="case__sections">
        {
          sections.map((section) => (
            <section class="case__section" data-reveal>
              <h2 class="case__section-title">{section.title}</h2>
              <p>{section.text}</p>
            </section>
          ))
        }
      </div>

      <div class="case__actions" data-reveal>
        <a class="btn" href={project.repo} target="_blank" rel="noopener noreferrer">
          {t.work.github}
          <svg class="icon" viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12L12 4M5.5 4H12v6.5" /></svg>
        </a>
      </div>

      <nav class="case__next" aria-label={t.project.alsoSee}>
        {
          browsable ? (
            <a class="next-row" href={i18n.path(projects.route(next, category))} data-flap-host>
              <span class="next-row__label">{t.project.next} · {next.label} · {categoryCopy.title}</span>
              <FlapText text={next.title} label={next.title} hover wrap class="next-row__title" />
              <span class="next-row__type">{next.copy(locale).type}</span>
            </a>
          ) : (
            <div class="case__more">
              <p class="h3" set:html={t.project.moreTitle} />
              <p class="body-text">{t.project.moreText}</p>
              <a class="text-link" href={`${home}#work`}>{t.project.moreLink}</a>
            </div>
          )
        }
        <div class="also">
          <p class="also__label">{t.project.alsoSee}</p>
          <ul class="also__list">
            {
              otherCategories.map((other) => (
                <li>
                  <a class="also__item" href={i18n.path(other.route())}>
                    <span class="also__icon" aria-hidden="true"><Icon name={other.icon} size={22} strokeWidth={1.6} /></span>
                    <span class="also__name">{other.copy(locale).title}</span>
                    <span class="also__count">{count(projects.inCategory(other).length)}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .case {
    position: relative;
    padding: calc(var(--header-h) + clamp(20px, 3vw, 40px)) 0 var(--section-y);
  }

  .case .board-line {
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  .case .container {
    position: relative;
    z-index: 1;
  }

  .case__back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 800 14px/1 var(--font-sans);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--lilac);
    transition: color 0.3s;
  }

  .case__back:hover {
    color: var(--yellow);
  }

  /* ---------- the shelf: the category and its projects, one tab each ---------- */
  .shelf {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'title step'
      'intro intro'
      'tabs tabs';
    align-items: center;
    gap: 12px 32px;
    margin-bottom: clamp(32px, 4vw, 56px);
    view-transition-name: shelf;
  }

  .shelf__title {
    grid-area: title;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font: 400 clamp(28px, 3vw, 44px) / 0.98 var(--font-display);
    text-transform: uppercase;
    color: var(--paper);
  }

  .shelf__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--on-yellow);
  }

  .shelf__intro {
    grid-area: intro;
    max-width: 46em;
    color: var(--lilac);
    font-size: 16px;
  }

  .shelf__tabs {
    grid-area: tabs;
    display: flex;
    flex-wrap: wrap;
    gap: 0 clamp(20px, 3vw, 40px);
    margin-top: 6px;
    background: linear-gradient(var(--line), var(--line)) left bottom / 100% 1px no-repeat;
  }

  /* a tab reads like a nav link: paper, yellow on hover, and the current one underlined in yellow */
  .shelf__tab {
    position: relative;
    display: grid;
    gap: 6px;
    padding: 10px 0 14px;
    color: var(--paper);
    transition: color 0.3s;
  }

  .shelf__tab::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: var(--yellow);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease-out);
  }

  .shelf__tab:hover,
  .shelf__tab[aria-current='page'] {
    color: var(--yellow);
  }

  .shelf__tab:hover::after,
  .shelf__tab[aria-current='page']::after {
    transform: scaleX(1);
  }

  .shelf__tab-meta {
    font: 450 11px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .shelf__tab-name {
    font: 400 clamp(20px, 2vw, 28px) / 1 var(--font-display);
    text-transform: uppercase;
  }

  .shelf__step {
    grid-area: step;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px 10px;
  }

  .shelf__arrow {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius);
    color: var(--lilac);
    transition: background-color 0.3s, color 0.3s;
  }

  .shelf__arrow:hover {
    background: var(--yellow);
    color: var(--on-yellow);
  }

  .shelf__keys {
    flex-basis: 100%;
    text-align: right;
    font-size: 13px;
    color: var(--dim);
  }

  @media (hover: none) {
    .shelf__keys {
      display: none;
    }
  }

  /* ---------- the case itself ---------- */
  /* the project's name beside its summary, like the section heads on the home page */
  .case__head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 18px clamp(32px, 5vw, 72px);
    align-items: end;
  }

  .case__title {
    font-size: clamp(48px, 6.4vw, 96px);
    view-transition-name: case-title;
  }

  .case__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 0 28px;
    margin-top: clamp(32px, 4vw, 48px);
  }

  .case__facts div {
    display: grid;
    gap: 6px;
    padding: 16px 0;
    background: linear-gradient(var(--line-strong), var(--line-strong)) left top / 100% 1px no-repeat;
  }

  .case__facts dt {
    font: 450 11px/1.4 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .case__facts dd {
    font-size: 16px;
  }

  .case__shot {
    margin-top: clamp(28px, 3.5vw, 48px);
  }

  .case__bar {
    display: flex;
    justify-content: space-between;
    padding-bottom: 10px;
    font: 450 11px/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dim);
  }

  /* the screenshot as a cream print, like the cards on the home page */
  .case__frame {
    display: block;
    padding: clamp(10px, 1.4vw, 18px);
    background: var(--cream);
    border-radius: var(--radius-card);
    box-shadow: 0 50px 80px -50px rgb(0 0 0 / 0.8);
    rotate: -0.6deg;
    view-transition-name: case-shot;
  }

  .case__frame :global(img) {
    width: 100%;
    border-radius: var(--radius);
  }

  .case__dim {
    position: relative;
    display: block;
    height: 12px;
    margin-top: 12px;
    background: linear-gradient(rgb(255 207 51 / 0.4), rgb(255 207 51 / 0.4)) left center / 100% 1px no-repeat;
  }

  .case__dim::before,
  .case__dim::after {
    content: '';
    position: absolute;
    top: 0;
    width: 1px;
    height: 100%;
    background: rgb(255 207 51 / 0.5);
  }

  .case__dim::before {
    left: 0;
  }

  .case__dim::after {
    right: 0;
  }

  .case__dim span {
    position: absolute;
    left: 50%;
    top: -2px;
    transform: translateX(-50%);
    padding: 0 10px;
    background: var(--board);
    font: 450 11px/1.4 var(--font-mono);
    letter-spacing: 0.1em;
    color: rgb(255 207 51 / 0.75);
  }

  .case__sections {
    display: grid;
    margin-top: clamp(56px, 7vw, 96px);
  }

  .case__section {
    display: grid;
    grid-template-columns: minmax(180px, 0.35fr) minmax(0, 1fr);
    gap: 16px 48px;
    padding: 28px 0;
    background: linear-gradient(var(--line), var(--line)) left top / 100% 1px no-repeat;
  }

  .case__section-title {
    font: 400 26px/1 var(--font-display);
    text-transform: uppercase;
    color: var(--yellow);
  }

  .case__section p {
    max-width: 40em;
    color: var(--lilac);
  }

  .case__actions {
    margin-top: 40px;
  }

  /* ---------- the next project on the shelf, and the other shelves ---------- */
  .case__next {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: 40px clamp(40px, 6vw, 96px);
    margin-top: clamp(80px, 10vw, 140px);
    padding-top: 32px;
    background: linear-gradient(var(--line-strong), var(--line-strong)) left top / 100% 1px no-repeat;
  }

  .next-row {
    display: grid;
    gap: 16px;
    justify-items: start;
    align-content: start;
  }

  .next-row__label,
  .also__label {
    font: 450 11px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .next-row :global(.next-row__title) {
    --tw: 0.8;
    --th: 1.14;
    --gap: 0.07em;
    font-size: clamp(40px, 5vw, 72px);
  }

  .next-row__type {
    color: var(--lilac);
  }

  .case__more {
    display: grid;
    gap: 14px;
    justify-items: start;
    align-content: start;
  }

  .also {
    display: grid;
    gap: 14px;
    align-content: start;
  }

  .also__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    background: linear-gradient(var(--line), var(--line)) left top / 100% 1px no-repeat;
  }

  .also__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--board-3);
    color: var(--yellow);
    transition: background-color 0.3s, color 0.3s;
  }

  .also__name {
    font: 400 24px/1 var(--font-display);
    text-transform: uppercase;
    color: var(--paper);
    transition: color 0.3s;
  }

  .also__count {
    font: 450 11px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .also__item:hover .also__icon {
    background: var(--yellow);
    color: var(--on-yellow);
  }

  .also__item:hover .also__name {
    color: var(--yellow);
  }

  @media (max-width: 900px) {
    .case__head,
    .case__section,
    .case__next {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .shelf {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'title'
        'intro'
        'tabs'
        'step';
    }

    .shelf__step {
      justify-content: flex-start;
    }

    /* "Gameontwikkeling" is 11em wide: scale the title with the screen so it never clips */
    .shelf__title {
      font-size: min(28px, 6.6vw);
      gap: 10px;
    }

    .shelf__icon {
      width: 38px;
      height: 38px;
    }

    /* on a phone the project comes first: the category intro is kept to two lines */
    .shelf__intro {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      overflow: hidden;
      font-size: 15px;
    }
  }
</style>
