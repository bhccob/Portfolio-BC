---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Projects from '../components/home/Projects.astro';
import About from '../components/home/About.astro';
import Skills from '../components/home/Skills.astro';
import OffDuty from '../components/home/OffDuty.astro';
import Career from '../components/home/Career.astro';
import EngineRoom from '../components/home/EngineRoom.astro';
import FinalCall from '../components/home/FinalCall.astro';
import { Translator, type Locale } from '../i18n/Translator';
import { categories } from '../data/categories';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i18n = new Translator(locale);
const site = Astro.site!;

const projectList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: i18n.t.nav.work,
  itemListElement: categories.all().map((category, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(i18n.path(category.route()), site).href,
    name: category.copy(locale).title
  }))
};
---

<BaseLayout
  locale={locale}
  route="/"
  title={i18n.t.meta.homeTitle}
  description={i18n.t.meta.homeDescription}
  ogType="profile"
  structuredData={[projectList]}
  page="home"
>
  <Hero locale={locale} />
  <Projects locale={locale} />
  <About locale={locale} />
  <Skills locale={locale} />
  <OffDuty locale={locale} />
  <Career locale={locale} />
  <EngineRoom locale={locale} />
  <FinalCall locale={locale} />
</BaseLayout>
