---
import portrait from '../../assets/portrait.jpg';
import { Translator, type Locale } from '../../i18n/Translator';
import { profile } from '../../data/profile';

/*
 * The device and its teardown: a tall scroll track with a stage pinned to the
 * viewport, the WebGL canvas behind one short text block per section. Scripts
 * (DeviceStageController) light the canvas and show the section the scroll is
 * in; without them, with reduced motion or without WebGL, the stage is a plain
 * page with every section stacked and the portrait as a still.
 */

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = new Translator(locale);
const b = t.bench;
---

<div class="device" data-device-track>
  <div
    class="device__stage"
    data-device-stage
    data-spec-lines={JSON.stringify(b.spec.lines)}
    data-chip-names={JSON.stringify(b.projects.chips)}
  >
    <canvas class="device__canvas" data-device-canvas aria-hidden="true"></canvas>

    <div class="device__copy">
      <section class="device__section device__section--hello" data-section="hello" data-active>
        <h1 class="title device__name">{profile.name}</h1>
        <p class="hud-label">{b.hello.label}</p>
      </section>

      <section class="device__section" data-section="about">
        <img
          class="device__still"
          src={portrait.src}
          width={portrait.width}
          height={portrait.height}
          alt={b.about.portraitAlt}
          loading="lazy"
          decoding="async"
        />
        <p class="hud-label">{b.about.label}</p>
        <p class="lead">{b.about.text}</p>
      </section>

      <section class="device__section" data-section="projects" aria-labelledby="device-projects">
        <p class="hud-label">{b.projects.label}</p>
        <h2 class="title device__title" id="device-projects">{b.projects.title}</h2>
        <p class="lead">{b.projects.text}</p>
        <p class="hud-label device__readout" data-chip-readout></p>
      </section>

      <section class="device__section" data-section="offduty" aria-labelledby="device-offduty">
        <h2 class="title device__title" id="device-offduty">{b.offduty.title}</h2>
        <p class="lead">{b.offduty.text}</p>
      </section>

      <section class="device__section" data-section="spec" aria-labelledby="device-spec">
        <h2 class="title device__title" id="device-spec">{b.spec.title}</h2>
        <ul class="device__spec">
          {b.spec.lines.map((line) => <li class="hud-label">{line}</li>)}
        </ul>
      </section>
    </div>
  </div>
</div>

<style>
  /* ---------- stacked: the page without scripts, motion or WebGL ---------- */
  .device__stage {
    padding: clamp(64px, 12svh, 128px) var(--gutter);
  }

  .device__canvas,
  .device__readout {
    display: none;
  }

  .device__copy {
    display: grid;
    gap: clamp(72px, 12svh, 128px);
    max-width: 1100px;
    margin-inline: auto;
  }

  .device__section {
    display: grid;
    justify-items: start;
    align-content: start;
    gap: 14px;
  }

  .device__name {
    font-size: clamp(44px, 9vw, 136px);
    line-height: 0.95;
  }

  .device__title {
    font-size: clamp(30px, 4.2vw, 60px);
  }

  .device__still {
    width: min(280px, 70vw);
    margin-bottom: 12px;
    border-radius: 14px;
    background: var(--board-deep);
  }

  .device__spec {
    display: grid;
    gap: 6px;
  }

  .device__spec li {
    color: var(--yellow);
  }

  /*
   * ---------- live: the stage sticks to the viewport while the track scrolls past ----------
   * The scene is transparent, so the stage paints the board it lies on. The
   * text sits above the canvas but lets the pointer through to the chips.
   * js-motion is set before first paint and taken off again if the bench
   * module never runs (BenchLayout's failsafe), so this layout never waits
   * on a script that is not coming.
   */
  :global(.js-motion) .device:not(:has([data-fallback])) {
    height: 500svh;
  }

  :global(.js-motion) .device__stage:not([data-fallback]) {
    position: sticky;
    top: 0;
    height: 100svh;
    padding: 0;
    overflow: hidden;
    background: radial-gradient(120% 95% at 50% 42%, var(--board) 48%, var(--board-deep) 100%);
  }

  :global(.js-motion) .device__stage:not([data-fallback]) .device__canvas {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  :global(.js-motion) .device__stage:not([data-fallback]) .device__copy {
    position: absolute;
    inset: 0;
    display: block;
    max-width: none;
    pointer-events: none;
  }

  :global(.js-motion) .device__stage:not([data-fallback]) :is(a, button) {
    pointer-events: auto;
  }

  /* Each section's text holds the top of the frame, which the camera leaves clear of the device. */
  :global(.js-motion) .device__stage:not([data-fallback]) .device__section {
    position: absolute;
    top: clamp(24px, 7svh, 80px);
    left: var(--gutter);
    right: var(--gutter);
    max-width: 36rem;
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.6s var(--ease-out);
  }

  :global(.js-motion) .device__stage:not([data-fallback]) .device__section--hello {
    max-width: none;
  }

  :global(.js-motion) .device__stage:not([data-fallback]) .device__section[data-active] {
    opacity: 1;
    transform: none;
  }

  /* The first section the script sets (after a reload mid-page) appears without a fade. */
  :global(.js-motion) .device__stage[data-settling]:not([data-fallback]) .device__section {
    transition: none;
  }

  :global(.js-motion) .device__stage:not([data-fallback]) .device__still {
    display: none;
  }

  /* The chip under the pointer, while the board is in view; the line keeps its height when empty. */
  :global(.js-motion) .device__stage:not([data-fallback]) .device__readout {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: calc(var(--hud-size) * 1.5);
    color: var(--yellow);
  }

  .device__readout:not(:empty)::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--yellow);
  }
</style>
