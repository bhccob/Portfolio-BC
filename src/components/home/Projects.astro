---
import { Picture } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import LineObjects from '../ui/LineObjects.astro';
import { Translator, type Locale } from '../../i18n/Translator';
import { categories } from '../../data/categories';
import { projects } from '../../data/projects';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i18n = new Translator(locale);
const { t } = i18n;
const rail = Array.from({ length: 12 }, () => t.work.rail.toUpperCase());

// One print per category: its newest screenshots fanned out, its name, how many projects and what they are built with.
const shelves = categories.all().map((category) => {
  const list = projects.inCategory(category);
  const stack = [...new Set(list.flatMap((project) => project.stack))].slice(0, 4);
  return {
    category,
    copy: category.copy(locale),
    list,
    stack,
    count: list.length === 1 ? t.work.countOne : i18n.format(t.work.countMany, { n: list.length })
  };
});
---

<section class="work section" id="work" aria-labelledby="work-title">
  <LineObjects
    items={[
      { icon: 'braces', x: 84, y: 4, size: 64, speed: 0.2, note: '{ }' },
      { icon: 'controller', x: 50, y: 2, size: 56, speed: -0.15, rotate: -12, accent: true }
    ]}
  />
  <div class="container">
    <div class="work__board" data-recede-inner>
      <header class="work__head">
        <h2 id="work-title" class="display h2" data-split set:html={t.work.title} />
        <p class="body-text" data-reveal>{t.work.intro}</p>
      </header>

      <div class="work__deck">
        <div class="rail" aria-hidden="true">
          <div class="rail__track">
            {[...rail, ...rail].map((word) => <span>{word}</span>)}
          </div>
        </div>

        <div class="work__gallery">
          <ol class="cards" data-drift>
            {
              shelves.map(({ category, copy, list, stack, count }, index) => (
                <li class="cards__item" style={`--tilt:${index % 2 ? 1.6 : -1.4}deg`}>
                  <a class="card" href={i18n.path(category.route())} data-tilt>
                    <span class="card__shot">
                      {list.slice(0, 3).map((project, layer) => (
                        <span
                          class="card__print"
                          style={`--layer:${layer};--count:${Math.min(list.length, 3)}${project.crop ? `;--shot-pos:${project.crop.position}` : ''}`}
                        >
                          <Picture
                            src={project.image}
                            formats={['avif', 'webp']}
                            widths={[480, 800, 1200]}
                            sizes={`(max-width: 760px) ${Math.round(70 * (project.crop?.zoom ?? 1))}vw, ${Math.round(320 * (project.crop?.zoom ?? 1))}px`}
                            alt=""
                            loading="lazy"
                          />
                        </span>
                      ))}
                      <span class="card__icon" aria-hidden="true"><Icon name={category.icon} size={26} strokeWidth={1.6} /></span>
                    </span>
                    <span class="card__title">{copy.title}</span>
                    <span class="card__stack">{stack.join(' · ')}</span>
                    <span class="card__meta">
                      <span class="card__count">{count}</span>
                      <span class="card__go">
                        {t.work.view}
                        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" /></svg>
                      </span>
                    </span>
                  </a>
                </li>
              ))
            }
            <li class="cards__item" style="--tilt:-0.8deg">
              <a class="card card--next" href="#career" id="work-next">
                <span class="card__slot" aria-hidden="true"><Icon name="chip" size={84} strokeWidth={1.1} /></span>
                <span class="card__title" set:html={t.work.nextTitle} />
                <span class="card__text">{t.work.nextText}</span>
                <span class="card__meta">
                  <span></span>
                  <span class="card__go">
                    {t.work.nextLink}
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M8 2v11M4 9l4 4 4-4" /></svg>
                  </span>
                </span>
              </a>
            </li>
          </ol>
        </div>
      </div>

      <p class="held" id="work-held"><strong>{t.work.heldTitle}.</strong> {t.work.heldText}</p>
    </div>
  </div>
</section>

<style>
  .work__head {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    align-items: end;
    gap: 24px 64px;
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  .work__deck {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: clamp(16px, 2vw, 28px);
  }

  /* a vertical ticker rail, like the edge of a film strip */
  .rail {
    position: relative;
    overflow: hidden;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius-card);
  }

  .rail__track {
    position: absolute;
    left: 50%;
    top: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    padding-top: 20px;
    transform: translateX(-50%);
    animation: rail 26s linear infinite;
  }

  .rail__track span {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font: 800 15px/1 var(--font-sans);
    letter-spacing: 0.06em;
    color: var(--paper);
  }

  @keyframes rail {
    to {
      transform: translate(-50%, -50%);
    }
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(18px, 2.4vw, 36px);
    align-items: stretch;
  }

  .work__gallery {
    container-type: inline-size;
  }

  /*
   * While scroll motion runs, the prints become a gallery: one row of wide prints, longer than
   * the board, that slides left through it as the visitor scrolls (ScrollScenes.drift). Prints
   * leave under the rail's edge and run off the right of the screen. Without motion they stay
   * the grid above, all in view.
   */
  :global(html.motion-ready) .work__gallery {
    /* a little slack on the left keeps a tilted print's corner whole */
    clip-path: inset(-80px -100vw -80px -14px);
  }

  :global(html.motion-ready) .cards {
    grid-template-columns: none;
    grid-auto-flow: column;
    grid-auto-columns: 46cqi;
    width: max-content;
  }

  /* the screenshot area gives up height on shorter screens, so the held section still fits */
  :global(html.motion-ready) .card__shot,
  :global(html.motion-ready) .card__slot {
    aspect-ratio: auto;
    height: clamp(150px, calc(100svh - 560px), 60cqi);
  }

  /* screenshots sized by the area's height, so they fit it at any width */
  :global(html.motion-ready) .card__print {
    width: auto;
    height: 80%;
    aspect-ratio: 4 / 3;
  }

  .cards__item {
    display: grid;
    rotate: var(--tilt);
    transition: rotate 0.6s var(--ease-out);
  }

  .cards__item:hover {
    rotate: 0deg;
  }

  /* cream prints for the work, pinned to the board; they lean toward the pointer (TiltCards.ts) */
  .card {
    container-type: inline-size;
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    gap: 12px;
    padding: 14px 14px 22px;
    background: var(--cream);
    color: var(--on-cream);
    border-radius: var(--radius-card);
    box-shadow: 0 30px 50px -30px rgb(0 0 0 / 0.7);
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) translateY(var(--lift, 0px));
    transition: transform 0.6s var(--ease-out), box-shadow 0.6s var(--ease-out);
  }

  .card:hover {
    --lift: -8px;
    box-shadow: 0 44px 60px -30px rgb(0 0 0 / 0.8);
  }

  .card:global(.is-tilting) {
    transition: transform 0.12s linear, box-shadow 0.6s var(--ease-out);
  }

  /* the category's screenshots, fanned out like a small stack of prints */
  .card__shot {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--board-3);
    aspect-ratio: 4 / 3;
  }

  .card__print {
    --spread: calc((var(--layer) - (var(--count) - 1) / 2));
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: calc(10 - var(--layer));
    width: 72%;
    aspect-ratio: 4 / 3;
    padding: 5px;
    background: var(--cream);
    border-radius: 4px;
    box-shadow: 0 18px 30px -16px rgb(0 0 0 / 0.75);
    transform: translate(-50%, -50%) translate(calc(var(--spread) * 13%), calc(var(--spread) * -5% + 4%)) rotate(calc(var(--spread) * 7deg));
    transition: transform 0.7s var(--ease-out);
  }

  .card:hover .card__print {
    transform: translate(-50%, -50%) translate(calc(var(--spread) * 22%), calc(var(--spread) * -7% + 2%)) rotate(calc(var(--spread) * 11deg)) scale(1.03);
  }

  .card__print :global(picture),
  .card__print :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 2px;
    object-fit: cover;
    object-position: var(--shot-pos, center);
  }

  .card__icon {
    position: absolute;
    left: 12px;
    top: 12px;
    z-index: 20;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--on-yellow);
  }

  /* long Dutch compounds ("Gameontwikkeling") must fit the print, so the size follows its width */
  .card__title {
    margin-top: 8px;
    font: 400 min(40px, 8.4cqi) / 0.95 var(--font-display);
    text-transform: uppercase;
    text-align: center;
    color: var(--purple);
    text-wrap: balance;
  }

  .card__title :global(em) {
    font-style: normal;
    color: var(--purple);
  }

  .card__stack {
    font: 450 11px/1.5 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
    color: var(--on-cream-soft);
  }

  .card__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: 4px;
    padding-top: 12px;
    background: linear-gradient(rgb(28 16 48 / 0.15), rgb(28 16 48 / 0.15)) left top / 100% 1px no-repeat;
    font: 800 13px/1.2 var(--font-sans);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .card__count {
    color: var(--on-cream-soft);
  }

  .card__go {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 8px;
    color: var(--on-cream);
  }

  .card__go svg {
    transition: transform 0.4s var(--ease-out);
  }

  .card:hover .card__go svg {
    transform: translateX(4px);
  }

  /* the next category: an empty slot, waiting for its print */
  .card--next {
    grid-template-rows: auto auto 1fr auto;
    background: transparent;
    color: var(--paper);
    border: 2px dashed var(--line-strong);
    box-shadow: none;
  }

  .card--next:hover {
    box-shadow: none;
    border-color: var(--yellow);
  }

  .card__slot {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    background: var(--board-2);
    color: var(--dim);
    transition: color 0.4s;
  }

  .card--next:hover .card__slot {
    color: var(--yellow);
  }

  .card--next .card__title,
  .card--next .card__title :global(em) {
    color: var(--paper);
    font-size: min(34px, 7.4cqi);
  }

  .card__text {
    font-size: 15px;
    line-height: 1.5;
    color: var(--lilac);
    text-align: center;
  }

  .card--next .card__meta {
    background: linear-gradient(var(--line-strong), var(--line-strong)) left top / 100% 1px no-repeat;
  }

  .card--next .card__go {
    color: var(--yellow);
  }

  .card--next:hover .card__go svg {
    transform: translateY(3px);
  }

  .held {
    max-width: 60em;
    margin: clamp(32px, 4vw, 48px) 0 0 calc(52px + clamp(16px, 2vw, 28px));
    font-size: 16px;
    color: var(--lilac);
  }

  .held strong {
    color: var(--paper);
    font-weight: 700;
  }

  @media (max-width: 1000px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .work__head {
      grid-template-columns: 1fr;
    }

    .work__deck {
      grid-template-columns: 1fr;
    }

    .rail {
      display: none;
    }

    .cards {
      grid-template-columns: 1fr;
    }

    /* one print in view on a phone, with the edge of the next one showing */
    :global(html.motion-ready) .cards {
      grid-auto-columns: 82cqi;
    }

    .held {
      margin-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail__track {
      animation: none;
    }
  }
</style>
