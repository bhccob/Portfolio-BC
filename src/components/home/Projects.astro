---
import { Picture } from 'astro:assets';
import LineObjects from '../ui/LineObjects.astro';
import { Translator, type Locale } from '../../i18n/Translator';
import { projects } from '../../data/projects';
import { profile } from '../../data/profile';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i18n = new Translator(locale);
const { t } = i18n;
const list = projects.all();
const github = profile.social('github');
const rail = Array.from({ length: 12 }, () => t.work.rail.toUpperCase());
---

<section class="work section" id="work" aria-labelledby="work-title">
  <LineObjects
    items={[
      { icon: 'braces', x: 84, y: 4, size: 64, speed: 0.2, note: '{ }' },
      { icon: 'controller', x: 50, y: 2, size: 56, speed: -0.15, rotate: -12, accent: true }
    ]}
  />
  <div class="container">
    <header class="work__head">
      <h2 id="work-title" class="display h2" data-split set:html={t.work.title} />
      <p class="body-text" data-reveal>{t.work.intro}</p>
    </header>

    <div class="work__deck">
      <div class="rail" aria-hidden="true">
        <div class="rail__track">
          {[...rail, ...rail].map((word) => <span>{word}</span>)}
        </div>
      </div>

      <ol class="cards">
        {
          list.map((project, index) => {
            const copy = project.copy(locale);
            return (
              <li class="cards__item" style={`--tilt:${index % 2 ? 1.6 : -1.4}deg`} data-reveal>
                <a class="card" href={i18n.path(project.route())}>
                  <span class="card__shot" style={project.crop ? `--shot-pos:${project.crop.position}` : undefined}>
                    <Picture
                      src={project.image}
                      formats={['avif', 'webp']}
                      widths={[600, 1000, 1500, 2200]}
                      sizes={`(max-width: 760px) ${Math.round(86 * (project.crop?.zoom ?? 1))}vw, ${Math.round(440 * (project.crop?.zoom ?? 1))}px`}
                      alt={copy.imageAlt}
                      loading="lazy"
                    />
                  </span>
                  <span class="card__category">{copy.category}</span>
                  <span class="card__title">{project.title}</span>
                  <span class="card__meta">
                    <span>{project.label} · {project.year}</span>
                    <span class="card__go">
                      {t.work.view}
                      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" /></svg>
                    </span>
                  </span>
                </a>
              </li>
            );
          })
        }
        <li class="cards__item" style="--tilt:-0.8deg" data-reveal>
          <a class="card card--next" href={github.url} target="_blank" rel="noopener noreferrer" id="work-next">
            <span class="card__slot" aria-hidden="true">{projects.upcomingLabel}</span>
            <span class="card__category">{t.work.soon}</span>
            <span class="card__title" set:html={t.work.nextTitle} />
            <span class="card__text">{t.work.nextText}</span>
            <span class="card__meta">
              <span>{projects.upcomingLabel}</span>
              <span class="card__go">
                {t.work.nextLink}
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M4 12L12 4M5.5 4H12v6.5" /></svg>
              </span>
            </span>
          </a>
        </li>
      </ol>
    </div>

    <p class="held" id="work-held"><strong>{t.work.heldTitle}.</strong> {t.work.heldText}</p>
  </div>
</section>

<style>
  .work__head {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    align-items: end;
    gap: 24px 64px;
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  .work__deck {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: clamp(16px, 2vw, 28px);
  }

  /* a vertical ticker rail, like the edge of a film strip */
  .rail {
    position: relative;
    overflow: hidden;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius-card);
  }

  .rail__track {
    position: absolute;
    left: 50%;
    top: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    padding-top: 20px;
    transform: translateX(-50%);
    animation: rail 26s linear infinite;
  }

  .rail__track span {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font: 800 15px/1 var(--font-sans);
    letter-spacing: 0.06em;
    color: var(--paper);
  }

  @keyframes rail {
    to {
      transform: translate(-50%, -50%);
    }
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(18px, 2.4vw, 36px);
    align-items: start;
  }

  .cards__item {
    rotate: var(--tilt);
    transition: rotate 0.6s var(--ease-out);
  }

  .cards__item:hover {
    rotate: 0deg;
  }

  /* cream cards for the work, like prints pinned to the board */
  .card {
    display: grid;
    gap: 12px;
    padding: 14px 14px 22px;
    background: var(--cream);
    color: var(--on-cream);
    border-radius: var(--radius-card);
    box-shadow: 0 30px 50px -30px rgb(0 0 0 / 0.7);
    transition: transform 0.6s var(--ease-out), box-shadow 0.6s var(--ease-out);
  }

  .card:hover {
    transform: translateY(-8px);
    box-shadow: 0 44px 60px -30px rgb(0 0 0 / 0.8);
  }

  .card__shot {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--board-3);
    aspect-ratio: 4 / 3;
  }

  .card__shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--shot-pos, center);
    transition: transform 0.9s var(--ease-out);
  }

  .card:hover .card__shot :global(img) {
    transform: scale(1.05);
  }

  .card__category {
    margin-top: 6px;
    font: 800 13px/1.3 var(--font-sans);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-cream-soft);
    text-align: center;
  }

  .card__title {
    font: 400 clamp(30px, 2.8vw, 42px) / 0.95 var(--font-display);
    text-transform: uppercase;
    text-align: center;
    color: var(--purple);
  }

  .card__title :global(em) {
    font-style: normal;
    color: var(--purple);
  }

  .card__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: 4px;
    padding-top: 12px;
    background: linear-gradient(rgb(28 16 48 / 0.15), rgb(28 16 48 / 0.15)) left top / 100% 1px no-repeat;
    font: 800 13px/1 var(--font-sans);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .card__go {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--on-cream);
  }

  .card__go svg {
    transition: transform 0.4s var(--ease-out);
  }

  .card:hover .card__go svg {
    transform: translateX(4px);
  }

  /* the next build: an empty slot, waiting for its print */
  .card--next {
    min-height: 100%;
    align-content: start;
    background: transparent;
    color: var(--paper);
    border: 2px dashed var(--line-strong);
    box-shadow: none;
  }

  .card--next:hover {
    box-shadow: none;
    border-color: var(--yellow);
  }

  .card__slot {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    background: var(--board-2);
    font: 400 clamp(54px, 6vw, 88px) / 1 var(--font-display);
    color: var(--board-3);
    -webkit-text-stroke: 2px var(--dim);
  }

  .card--next .card__category {
    color: var(--yellow);
  }

  .card--next .card__title,
  .card--next .card__title :global(em) {
    color: var(--paper);
    font-size: clamp(26px, 2.2vw, 34px);
  }

  .card__text {
    font-size: 15px;
    line-height: 1.5;
    color: var(--lilac);
    text-align: center;
  }

  .card--next .card__meta {
    background: linear-gradient(var(--line-strong), var(--line-strong)) left top / 100% 1px no-repeat;
  }

  .card--next .card__go {
    color: var(--yellow);
  }

  .held {
    max-width: 60em;
    margin: clamp(32px, 4vw, 48px) 0 0 calc(52px + clamp(16px, 2vw, 28px));
    font-size: 16px;
    color: var(--lilac);
  }

  .held strong {
    color: var(--paper);
    font-weight: 700;
  }

  @media (max-width: 1000px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .work__head {
      grid-template-columns: 1fr;
    }

    .work__deck {
      grid-template-columns: 1fr;
    }

    .rail {
      display: none;
    }

    .cards {
      grid-template-columns: 1fr;
    }

    .held {
      margin-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail__track {
      animation: none;
    }
  }
</style>
