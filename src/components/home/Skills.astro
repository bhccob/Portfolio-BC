---
import FlapText from '../ui/FlapText.astro';
import { Translator, type Locale } from '../../i18n/Translator';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = new Translator(locale);
const s = t.skills;
---

<section class="skills section" id="skills" aria-labelledby="skills-title">
  <div class="container skills__grid">
    <div class="skills__intro">
      <h2 id="skills-title" class="display h2" data-split set:html={s.title} />
      <p class="mixed skills__statement" data-mixed>
        <span class="visually-hidden">{s.statementSpoken}</span>
        <span aria-hidden="true">
          {s.statement.map(([text, style]) => <><span class:list={['mixed__w', `mixed__w--${style}`]} data-mixed-word>{text}</span>{' '}</>)}
        </span>
      </p>
    </div>

    <ol class="stack">
      {
        s.rows.map((row, index) => (
          <li class:list={['stack__row', { 'stack__row--lead': index === 0 }]} data-reveal data-flap-host>
            <FlapText text={row.status} hover tone={index === 3 ? 'lilac' : 'yellow'} class="stack__status" />
            <div class="stack__body">
              <h3 class="stack__title">{row.title}</h3>
              <p class="stack__text">{row.text}</p>

            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .skills__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 48px clamp(40px, 6vw, 96px);
    align-items: start;
  }

  .skills__intro {
    position: sticky;
    top: calc(var(--header-h) + 32px);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
  }

  .skills__statement {
    font-size: clamp(24px, 2.3vw, 34px);
  }

  /* four rows, from what is solid today to what comes next */
  .stack__row {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 14px 28px;
    padding: 26px 0;
    background: linear-gradient(var(--line), var(--line)) left top / 100% 1px no-repeat;
  }

  .stack__row:last-child {
    background:
      linear-gradient(var(--line), var(--line)) left top / 100% 1px no-repeat,
      linear-gradient(var(--line), var(--line)) left bottom / 100% 1px no-repeat;
  }

  .stack :global(.stack__status) {
    --tw: 0.84;
    --th: 1.4;
    --gap: 0.1em;
    font-size: 15px;
    align-self: start;
  }

  .stack__body {
    display: grid;
    gap: 10px;
  }

  .stack__title {
    font: 400 clamp(22px, 2.1vw, 30px) / 1 var(--font-display);
    text-transform: uppercase;
    color: var(--paper);
  }

  .stack__row--lead .stack__title {
    color: var(--yellow);
  }

  .stack__text {
    max-width: 40em;
    font-size: 16px;
    color: var(--lilac);
  }


  @media (max-width: 960px) {
    .skills__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .skills__intro {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .stack__row {
      grid-template-columns: minmax(0, 1fr);
    }

  }
</style>
