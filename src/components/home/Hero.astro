---
import LineObjects from '../ui/LineObjects.astro';
import { Translator, type Locale } from '../../i18n/Translator';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = new Translator(locale);
const h = t.hero;

// The last word gets the ping-pong ball: it takes the place of the first "O",
// or sits after the word when there is none (e.g. "eerlijkheid").
const lines = h.lines.map((text, index) => ({ text: text.toUpperCase(), big: index % 2 === 1 }));
const last = lines[lines.length - 1].text;
const ballAt = last.indexOf('O');
const before = ballAt >= 0 ? last.slice(0, ballAt) : last;
const after = ballAt >= 0 ? last.slice(ballAt + 1) : '';

// Repeat the badge text so it always fills its circle.
const badge = h.badge.repeat(Math.max(1, Math.round(64 / h.badge.length)));
---

<section class="hero" id="top" data-hero aria-labelledby="hero-title">
  <LineObjects
    items={[
      { icon: 'sigma', x: 7, y: 22, size: 54, speed: 0.2 },
      { icon: 'chip', x: 88, y: 18, size: 46, speed: -0.15, accent: true },
      { icon: 'plate', x: 6, y: 74, size: 64, speed: 0.25, note: 'Ø 450' }
    ]}
  />

  <div class="hero__inner">
    <h1 id="hero-title" class="hero__title">
      <span class="hero__hello" data-hero-line>{h.hello}</span>
      <span class="visually-hidden">: {h.spoken}</span>
      <span class="hero__stack" aria-hidden="true">
        {
          lines.slice(0, -1).map((line) => (
            <span class:list={['hero__line', { 'hero__line--big': line.big }]} style={`--chars:${line.text.length}`} data-hero-line>
              {line.text}
            </span>
          ))
        }
        <span class="hero__line hero__line--big hero__line--last" style={`--chars:${last.length}`} data-hero-line>
          {before}
          <span class="ball" data-ball>
            <svg viewBox="0 0 100 100" aria-hidden="true">
              <circle class="ball__body" cx="50" cy="50" r="46" />
              <path class="ball__shine" d="M24 30a30 30 0 0 1 22-14" />
              <g class="ball__eye" transform="translate(37 52)"><ellipse rx="10" ry="17" /><circle class="ball__pupil" cy="-5" r="5.5" /></g>
              <g class="ball__eye" transform="translate(63 52)"><ellipse rx="10" ry="17" /><circle class="ball__pupil" cy="-5" r="5.5" /></g>
            </svg>
          </span>
          {after}
        </span>
      </span>
    </h1>
    <p class="hero__role" data-hero-line>{h.role}</p>
  </div>

  <a class="badge" href="#about" aria-label={t.nav.about}>
    <svg class="badge__ring" viewBox="0 0 200 200" aria-hidden="true">
      <defs><path id="badge-circle" d="M100,100 m-76,0 a76,76 0 1,1 152,0 a76,76 0 1,1 -152,0" /></defs>
      <text><textPath href="#badge-circle" textLength="474">{badge.toUpperCase()}</textPath></text>
    </svg>
    <span class="badge__core" aria-hidden="true">
      <svg viewBox="0 0 40 40" width="46%" height="46%">
        <circle cx="16" cy="16" r="12" fill="currentColor" />
        <rect x="23" y="22" width="6.5" height="15" rx="3.2" transform="rotate(-45 26 29.5)" fill="currentColor" />
        <circle cx="33" cy="8" r="3.6" fill="none" stroke="currentColor" stroke-width="2" />
      </svg>
    </span>
  </a>

  <a class="hero__scroll" href="#work"><span aria-hidden="true"></span>{h.scroll}</a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: calc(var(--header-h) + 24px) var(--gutter) 72px;
    overflow: clip;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: clamp(18px, 3vh, 30px);
    text-align: center;
  }

  .hero__title {
    display: grid;
    justify-items: center;
  }

  /* the hand-written hello sits on top of the stack like a sticker */
  .hero__hello {
    position: relative;
    z-index: 2;
    margin-bottom: -0.02em;
    margin-left: -0.6em;
    font: 400 clamp(34px, 4.4vw, 64px) / 1 var(--font-script);
    color: var(--yellow);
    transform: rotate(-5deg);
  }

  .hero__stack {
    display: grid;
    justify-items: center;
  }

  /* each line fits the width: fat type sized by its own length */
  .hero__line {
    display: block;
    font-family: var(--font-display);
    font-size: min(calc(78vw / (var(--chars) * 0.6)), 76px);
    line-height: 0.94;
    color: var(--paper);
    white-space: nowrap;
  }

  .hero__line--big {
    font-size: min(calc(88vw / (var(--chars) * 0.6)), 184px);
    line-height: 0.86;
    color: var(--yellow);
  }

  .hero__line--last {
    color: var(--paper);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* the ping-pong ball takes the place of an "O" and keeps an eye on you */
  .ball {
    display: inline-block;
    width: 0.74em;
    height: 0.74em;
    margin: 0 0.02em;
    transform: translateY(0.02em);
    transition: transform 0.5s var(--ease-out);
  }

  .ball svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .ball__body {
    fill: var(--yellow);
  }

  .ball__shine {
    fill: none;
    stroke: rgb(255 255 255 / 0.55);
    stroke-width: 5;
    stroke-linecap: round;
  }

  .ball__eye ellipse {
    fill: var(--paper);
    stroke: var(--on-yellow);
    stroke-width: 3.5;
  }

  .ball__pupil {
    fill: var(--on-yellow);
    transform: translate(var(--px, 0px), var(--py, 0px));
    transition: transform 0.18s ease-out;
  }

  .ball__eye ellipse,
  .ball__pupil {
    transform-box: fill-box;
    transform-origin: center;
  }

  .ball:global(.is-blink) .ball__eye ellipse {
    transform: scaleY(0.12);
  }

  .ball:global(.is-blink) .ball__pupil {
    transform: translate(var(--px, 0px), var(--py, 0px)) scaleY(0.12);
  }

  .ball:global(.is-hit) {
    animation: ball-hit 0.7s var(--ease-out);
  }

  @keyframes ball-hit {
    30% {
      transform: translateY(-0.35em) rotate(-20deg) scale(0.92, 1.08);
    }
    55% {
      transform: translateY(0.04em) scale(1.12, 0.88);
    }
    75% {
      transform: translateY(-0.08em);
    }
  }

  .hero__line--last {
    cursor: pointer;
  }

  .hero__line--last:hover .ball {
    transform: translateY(-0.08em) rotate(-12deg) scale(1.06);
  }

  .hero__role {
    font: 800 clamp(14px, 1.2vw, 17px) / 1.4 var(--font-sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lilac);
  }

  /* rotating circular badge */
  .badge {
    position: absolute;
    z-index: 2;
    right: clamp(18px, 6vw, 96px);
    bottom: clamp(40px, 9vh, 96px);
    width: clamp(118px, 12vw, 172px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }

  .badge__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: spin 26s linear infinite;
  }

  .badge__ring text {
    font: 800 15px var(--font-sans);
    letter-spacing: 0.04em;
    fill: var(--paper);
  }

  .badge__core {
    width: 46%;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--on-yellow);
    transition: transform 0.5s var(--ease-out);
  }

  .badge:hover .badge__core {
    transform: rotate(-30deg) scale(1.08);
  }

  .badge:hover .badge__ring {
    animation-duration: 8s;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 22px;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font: 800 12px/1 var(--font-sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lilac);
  }

  .hero__scroll span {
    width: 1px;
    height: 26px;
    background: linear-gradient(var(--yellow), transparent);
    transform-origin: top;
    animation: drip 1.9s var(--ease-in-out) infinite;
  }

  @keyframes drip {
    0% {
      transform: scaleY(0);
      opacity: 1;
    }
    55% {
      transform: scaleY(1);
      opacity: 1;
    }
    100% {
      transform: scaleY(1);
      opacity: 0;
    }
  }

  :global(html.flap-intro) .hero [data-hero-line] {
    opacity: 0;
  }

  @media (max-width: 720px) {
    .hero {
      min-height: 92svh;
      padding-bottom: 120px;
    }

    .badge {
      right: 16px;
      bottom: 64px;
      width: 104px;
    }

    .badge__ring text {
      font-size: 16px;
    }

    .hero__scroll {
      left: var(--gutter);
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .badge__ring,
    .hero__scroll span {
      animation: none;
    }
  }
</style>
