---
import LineObjects from '../ui/LineObjects.astro';
import { Translator, type Locale } from '../../i18n/Translator';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = new Translator(locale);
const h = t.hero;

// The ping-pong ball takes the place of the first "O" of the first name.
const [first, last] = h.name.map((word) => word.toUpperCase());
const ballAt = first.indexOf('O');
const before = ballAt >= 0 ? first.slice(0, ballAt) : first;
const after = ballAt >= 0 ? first.slice(ballAt + 1) : '';

// Repeat the badge text so it always fills its circle.
const badge = h.badge.repeat(Math.max(1, Math.round(64 / h.badge.length)));
---

<section class="hero" id="top" data-hero aria-labelledby="hero-title">
  <LineObjects
    items={[
      { icon: 'sigma', x: 7, y: 22, size: 54, speed: 0.2 },
      { icon: 'chip', x: 90, y: 18, size: 46, speed: -0.15, accent: true },
      { icon: 'plate', x: 6, y: 76, size: 64, speed: 0.25, note: 'Ø 450' }
    ]}
  />

  <div class="hero__inner">
    <h1 id="hero-title" class="hero__title">
      <span class="hero__hello" data-hero-line>{h.hello}</span>
      <span class="visually-hidden"> {h.name.join(' ')}</span>
      <span class="name" data-name-reveal aria-hidden="true">
        {/* Each word is printed twice: an outline, and a yellow fill shown only inside a circle that follows the pointer (NameReveal.ts). */}
        <span class="name__word name__word--first" data-name-word data-hero-line>
          <span class="name__ink name__ink--outline">
            {before}<span class="ball" data-ball>
              <svg viewBox="0 0 100 100" aria-hidden="true">
                <circle class="ball__body" cx="50" cy="50" r="46" />
                <path class="ball__shine" d="M24 30a30 30 0 0 1 22-14" />
                <g class="ball__eye" transform="translate(37 52)"><ellipse rx="10" ry="17" /><circle class="ball__pupil" cy="-5" r="5.5" /></g>
                <g class="ball__eye" transform="translate(63 52)"><ellipse rx="10" ry="17" /><circle class="ball__pupil" cy="-5" r="5.5" /></g>
              </svg>
            </span>{after}
          </span>
          <span class="name__ink name__ink--fill">{before}<span class="ball ball--gap"></span>{after}</span>
        </span>
        <span class="name__word name__word--last" data-name-word data-hero-line>
          <span class="name__ink name__ink--outline">{last}</span>
          <span class="name__ink name__ink--fill">{last}</span>
        </span>
      </span>
    </h1>

    <p class="hero__motto mixed" data-hero-line>
      {h.motto.map(([text, style]) => <><span class:list={['mixed__w', `mixed__w--${style}`]}>{text}</span>{' '}</>)}
    </p>

    <div class="hero__foot" data-hero-line>
      <p class="hero__role">{h.role}</p>
      <p class="hero__hint" data-name-hint data-touch={h.hintTouch}>
        <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="8" cy="8" r="6.2" /><circle cx="8" cy="8" r="2" fill="currentColor" stroke="none" /></svg>
        <span>{h.hint}</span>
      </p>
    </div>
  </div>

  <a class="badge" href="#about">
    <span class="visually-hidden">{t.nav.about}</span>
    <svg class="badge__ring" viewBox="0 0 200 200" aria-hidden="true">
      <defs><path id="badge-circle" d="M100,100 m-76,0 a76,76 0 1,1 152,0 a76,76 0 1,1 -152,0" /></defs>
      <text><textPath href="#badge-circle" textLength="474">{badge.toUpperCase()}</textPath></text>
    </svg>
    <span class="badge__core" aria-hidden="true">
      <svg viewBox="0 0 40 40" width="46%" height="46%">
        <g fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="18" cy="14.5" r="10" />
          <path d="M15.4 24.4v8.3a2.2 2.2 0 0 0 2.2 2.2h.8a2.2 2.2 0 0 0 2.2-2.2v-8.3" />
        </g>
        <circle cx="32" cy="30.5" r="3.2" fill="currentColor" />
      </svg>
    </span>
  </a>

  <a class="hero__scroll" href="#work"><span aria-hidden="true"></span>{h.scroll}</a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: calc(var(--header-h) + 16px) var(--gutter) 88px;
    overflow: clip;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    /*
     * One size drives the whole name: as large as the width allows (CHUNG is
     * 3.4em wide in Bagel Fat One) and as the height allows (hello, two lines
     * and the motto have to fit under the header).
     */
    --name: min(25vw, calc((100svh - 330px) / 1.75), 260px);
    display: grid;
    justify-items: start;
    width: max-content;
    max-width: 100%;
  }

  .hero__title {
    display: grid;
    justify-items: start;
  }

  /* the hand-written hello is stuck onto the name like a sticker */
  .hero__hello {
    position: relative;
    z-index: 2;
    margin: 0 0 calc(var(--name) * -0.12) calc(var(--name) * 0.08);
    font: 400 max(30px, calc(var(--name) * 0.26)) / 1 var(--font-script);
    color: var(--yellow);
    transform: rotate(-6deg);
    transform-origin: left bottom;
  }

  /* ---------- the name: outline print with a yellow fill under the pointer ---------- */
  .name {
    position: relative;
    display: grid;
    justify-items: start;
    font: 400 var(--name) / 0.84 var(--font-display);
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .name__word {
    position: relative;
    display: block;
    /* where the fill circle sits, in this word's own box (set by NameReveal.ts) */
    --x: -999px;
    --y: -999px;
    --r: 0px;
  }

  .name__ink {
    display: flex;
    align-items: center;
  }

  .name__ink--outline {
    color: transparent;
    -webkit-text-stroke: max(1.5px, calc(var(--name) * 0.009)) rgb(244 236 218 / 0.62);
  }

  .name__ink--fill {
    position: absolute;
    inset: 0;
    color: var(--yellow);
    clip-path: circle(var(--r) at var(--x) var(--y));
    pointer-events: none;
  }

  /* reduced motion, or before the script runs: the name is simply printed in yellow */
  .name.is-static .name__ink--fill,
  :global(html:not(.js)) .name__ink--fill {
    clip-path: none;
  }

  /* ---------- the ping-pong ball takes the place of the O and keeps an eye on you ---------- */
  .ball {
    display: inline-block;
    flex: none;
    width: 0.74em;
    height: 0.74em;
    margin: 0 0.015em;
    /* flex centres it on the line box; the capitals sit a little lower than that */
    --ball-y: 0.075em;
    transform: translateY(var(--ball-y));
    transition: transform 0.5s var(--ease-out);
  }

  .ball--gap {
    visibility: hidden;
  }

  .ball svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .ball__body {
    fill: var(--yellow);
  }

  .ball__shine {
    fill: none;
    stroke: rgb(255 255 255 / 0.55);
    stroke-width: 5;
    stroke-linecap: round;
  }

  .ball__eye ellipse {
    fill: var(--paper);
    stroke: var(--on-yellow);
    stroke-width: 3.5;
  }

  .ball__pupil {
    fill: var(--on-yellow);
    transform: translate(var(--px, 0px), var(--py, 0px));
    transition: transform 0.18s ease-out;
  }

  .ball__eye ellipse,
  .ball__pupil {
    transform-box: fill-box;
    transform-origin: center;
  }

  .ball:global(.is-blink) .ball__eye ellipse {
    transform: scaleY(0.12);
  }

  .ball:global(.is-blink) .ball__pupil {
    transform: translate(var(--px, 0px), var(--py, 0px)) scaleY(0.12);
  }

  .ball:global(.is-hit) {
    animation: ball-hit 0.7s var(--ease-out);
  }

  @keyframes ball-hit {
    30% {
      transform: translateY(calc(var(--ball-y) - 0.35em)) rotate(-20deg) scale(0.92, 1.08);
    }
    55% {
      transform: translateY(calc(var(--ball-y) + 0.02em)) scale(1.12, 0.88);
    }
    75% {
      transform: translateY(calc(var(--ball-y) - 0.1em));
    }
  }

  .name__word--first:hover .ball {
    transform: translateY(calc(var(--ball-y) - 0.1em)) rotate(-12deg) scale(1.06);
  }

  /* ---------- motto, role and hint ---------- */
  /* the motto and the foot wrap to the name's width instead of widening the block */
  .hero__motto,
  .hero__foot {
    contain: inline-size;
    justify-self: stretch;
  }

  .hero__motto {
    max-width: 30em;
    margin-top: clamp(18px, 3.2vh, 34px);
    font-size: clamp(20px, 1.9vw, 30px);
    text-wrap: balance;
  }

  .hero__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 28px;
    margin-top: clamp(14px, 2.4vh, 24px);
  }

  .hero__role {
    font: 800 clamp(13px, 1.1vw, 16px) / 1.4 var(--font-sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lilac);
  }

  .hero__hint {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--dim);
  }

  .hero__hint svg {
    color: var(--yellow);
  }

  /* rotating circular badge */
  .badge {
    position: absolute;
    z-index: 2;
    right: clamp(18px, 5vw, 80px);
    bottom: clamp(40px, 9vh, 96px);
    width: clamp(118px, 11vw, 160px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }

  .badge__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: spin 26s linear infinite;
  }

  .badge__ring text {
    font: 800 15px var(--font-sans);
    letter-spacing: 0.04em;
    fill: var(--paper);
  }

  .badge__core {
    width: 46%;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--on-yellow);
    transition: transform 0.5s var(--ease-out);
  }

  .badge:hover .badge__core {
    transform: rotate(-30deg) scale(1.08);
  }

  .badge:hover .badge__ring {
    animation-duration: 8s;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 22px;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font: 800 12px/1 var(--font-sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lilac);
  }

  .hero__scroll span {
    width: 1px;
    height: 26px;
    background: linear-gradient(var(--yellow), transparent);
    transform-origin: top;
    animation: drip 1.9s var(--ease-in-out) infinite;
  }

  @keyframes drip {
    0% {
      transform: scaleY(0);
      opacity: 1;
    }
    55% {
      transform: scaleY(1);
      opacity: 1;
    }
    100% {
      transform: scaleY(1);
      opacity: 0;
    }
  }

  :global(html.flap-intro) .hero [data-hero-line] {
    opacity: 0;
  }

  /* the badge would crowd the name on mid-size screens: tuck it into the corner */
  @media (max-width: 1100px) {
    .badge {
      width: 112px;
      bottom: 72px;
    }
  }

  @media (max-width: 720px) {
    .hero {
      min-height: 92svh;
      padding-bottom: 132px;
    }

    .hero__inner {
      --name: min(26vw, calc((100svh - 360px) / 1.75), 200px);
    }

    .hero__foot {
      flex-direction: column;
      align-items: flex-start;
    }

    .badge {
      right: 16px;
      bottom: 64px;
      width: 100px;
    }

    .badge__ring text {
      font-size: 16px;
    }

    .hero__scroll {
      left: var(--gutter);
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .badge__ring,
    .hero__scroll span {
      animation: none;
    }
  }
</style>
