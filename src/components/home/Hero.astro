---
import FlapText from '../ui/FlapText.astro';
import LineObjects from '../ui/LineObjects.astro';
import { Translator, type Locale } from '../../i18n/Translator';
import { projects } from '../../data/projects';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = new Translator(locale);
const b = t.board;

type Status = 'departed' | 'boarding' | 'held';
interface Row {
  href: string;
  year: string;
  project: string;
  line: string;
  status: Status;
  statusText: string;
}

const rows: Row[] = [
  ...projects.all().map((project) => ({
    href: `#${project.anchor}`,
    year: String(project.year),
    project: `${project.label} ${project.title}`,
    line: `${project.line} · ${project.copy(locale).areaShort}`,
    status: 'departed' as Status,
    statusText: b.departed
  })),
  { href: '#work-next', year: '----', project: b.nextTitle, line: b.nextLine, status: 'boarding', statusText: b.boarding },
  { href: '#work-held', year: '----', project: b.earlierTitle, line: b.earlierLine, status: 'held', statusText: b.held }
];

// Every column pads to its longest entry, so the tiles line up down the board.
const widest = (key: keyof Row) => Math.max(...rows.map((row) => row[key].length));
const pads = { year: 4, project: widest('project'), line: widest('line'), status: widest('statusText') };
const echoLength = b.echo.replace('{name}', 'XXXXXXXXX').length;
const rolePad = Math.max(b.role.length, echoLength);
const phases = JSON.stringify(b.phases);
---

<section class="hero" id="top" data-hero aria-labelledby="hero-title">
  <LineObjects
    items={[
      { icon: 'plate', x: 31, y: 7, size: 70, speed: 0.25, note: 'Ø 450' },
      { icon: 'paddle', x: 54, y: 11, size: 52, speed: -0.2, rotate: -20 },
      { icon: 'sine', x: 63, y: 89, size: 70, speed: 0.15, note: 'f(t)' },
      { icon: 'chip', x: 71, y: 9, size: 44, speed: 0.3, accent: true }
    ]}
  />

  <div class="hero__inner">
    <div class="hero__head">
      <p class="hero__words">
        {b.words.map((word, index) => (index === 0 ? <b>{word}</b> : <span lang={index === 1 ? (locale === 'en' ? 'nl' : 'en') : 'pap'}>{word}</span>))}
        <span class="hero__phase" data-phase-label data-phases={phases}>{b.phases.day}</span>
      </p>
      <div class="hero__clocks">
        <div class="clock">
          <FlapText text="--:--" play="none" label="" class="clock__time" data-clock="Europe/Amsterdam" />
          <span class="clock__place">{b.rotterdam}</span>
        </div>
        <div class="clock">
          <FlapText text="--:--" play="none" label="" class="clock__time" data-clock="America/Aruba" />
          <span class="clock__place">{b.aruba}</span>
        </div>
      </div>
    </div>

    <FlapText as="h1" id="hero-title" text="BOB CHUNG" label="Bob Chung" play="intro" wrap class="hero__name" data-flap-spell="" data-flap-tiles="" />
    <div class="hero__dim" aria-hidden="true"><span>{b.drawing}</span></div>
    <FlapText as="p" text={b.role} pad={rolePad} label={b.roleSpoken} play="intro" wrap class="hero__role" data-flap-echo={b.echo.toUpperCase()} />

    <div class="board" data-hero-board>
      <div class="board__head" aria-hidden="true">
        <span>{b.columns.year}</span>
        <span>{b.columns.project}</span>
        <span>{b.columns.line}</span>
        <span>{b.columns.status}</span>
      </div>
      <ol class="board__rows">
        {
          rows.map((row) => (
            <li>
              <a class:list={['dep', `dep--${row.status}`]} href={row.href}>
                <FlapText text={row.year} pad={pads.year} play="intro" hover label={row.year === '----' ? '' : row.year} class="dep__year" tone={row.status === 'held' ? 'dim' : 'yellow'} />
                <FlapText text={row.project} pad={pads.project} play="intro" hover class="dep__project" tone={row.status === 'held' ? 'dim' : 'yellow'} />
                <FlapText text={row.line} pad={pads.line} play="intro" hover class="dep__line" tone={row.status === 'held' ? 'dim' : 'lilac'} />
                <span class="dep__status">
                  <svg class="dep__mark" viewBox="0 0 14 14" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    {row.status === 'departed' && <path d="M2 7.5l3.2 3L12 3.5" />}
                    {row.status === 'boarding' && <path d="M3.5 2.5l7 4.5-7 4.5z" />}
                    {row.status === 'held' && <circle cx="7" cy="7" r="4.6" />}
                  </svg>
                  <FlapText text={row.statusText} pad={pads.status} play="intro" hover tone={row.status === 'held' ? 'dim' : 'yellow'} />
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="hero__foot">
      <p class="hero__line" set:html={b.line} />
      <div class="hero__aside">
        <p class="hero__hint">{b.typeHint}</p>
        <a class="hero__scroll" href="#work"><span aria-hidden="true"></span>{b.scroll}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    padding: calc(var(--header-h) + clamp(18px, 4vh, 48px)) var(--gutter) 28px;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    width: min(100%, 1440px);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(14px, 2.4vh, 26px);
  }

  .hero__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 32px;
    flex-wrap: wrap;
  }

  .hero__words {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font: 450 12px/1.5 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--lilac);
  }

  .hero__words b {
    color: var(--yellow);
    font-weight: 500;
  }

  .hero__phase {
    color: var(--dim);
  }

  .hero__phase::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 10px;
    border-radius: 50%;
    background: var(--yellow);
    vertical-align: 1px;
    animation: phase-blink 2.4s steps(1) infinite;
  }

  @keyframes phase-blink {
    50% {
      opacity: 0.25;
    }
  }

  .hero__clocks {
    display: flex;
    gap: 28px;
  }

  .clock {
    display: grid;
    gap: 7px;
    justify-items: end;
  }

  .clock :global(.clock__time) {
    --tw: 0.82;
    --th: 1.3;
    --gap: 0.1em;
    font-size: 22px;
  }

  .clock__place {
    font: 450 11px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  /* the name: the largest tiles on the board */
  .hero :global(.hero__name) {
    --tw: 0.76;
    --th: 1.08;
    --gap: 0.055em;
    --r: 0.05em;
    font-size: clamp(64px, 12.6vw, 196px);
    align-self: flex-start;
  }

  .hero :global(.hero__name .f.sp) {
    visibility: hidden;
    width: calc(var(--tw) * 0.55em);
  }

  .hero__dim {
    position: relative;
    height: 12px;
    margin-top: -4px;
    background: linear-gradient(rgb(255 207 51 / 0.42), rgb(255 207 51 / 0.42)) left center / 100% 1px no-repeat;
  }

  .hero__dim::before,
  .hero__dim::after {
    content: '';
    position: absolute;
    top: 0;
    width: 1px;
    height: 100%;
    background: rgb(255 207 51 / 0.5);
  }

  .hero__dim::before {
    left: 0;
  }

  .hero__dim::after {
    right: 0;
  }

  .hero__dim span {
    position: absolute;
    right: 18px;
    top: -14px;
    font: 450 10px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(255 207 51 / 0.7);
    background: var(--board);
    padding: 0 8px;
  }

  .hero :global(.hero__role) {
    --tw: 0.76;
    --th: 1.26;
    --gap: 0.09em;
    font-size: clamp(15px, 1.75vw, 26px);
  }

  /* departures */
  .board {
    margin-top: clamp(6px, 1.6vh, 18px);
  }

  .board__head,
  .dep {
    display: grid;
    grid-template-columns: minmax(70px, 0.5fr) minmax(0, 1.7fr) minmax(0, 1.3fr) minmax(0, 1.15fr);
    align-items: center;
    gap: 20px;
    padding: 0 14px;
  }

  .board__head {
    padding-bottom: 8px;
    font: 450 11px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .board__rows {
    display: grid;
    gap: 4px;
  }

  .dep {
    position: relative;
    padding-block: 9px;
    border-radius: var(--radius);
    transition: background-color 0.3s;
  }

  .dep::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 3px;
    height: 0;
    background: var(--yellow);
    border-radius: 2px;
    transition: height 0.35s var(--ease-out), top 0.35s var(--ease-out);
  }

  .dep:hover {
    background: rgb(255 207 51 / 0.05);
  }

  .dep:hover::before {
    top: 16%;
    height: 68%;
  }

  .dep :global(.flap) {
    --tw: 0.8;
    --th: 1.28;
    --gap: 0.08em;
    font-size: clamp(15px, 1.32vw, 20px);
    overflow: hidden;
    max-width: 100%;
  }

  .dep__status {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .dep__mark {
    flex: none;
    color: var(--yellow);
  }

  .dep--held {
    opacity: 0.75;
  }

  .dep--held .dep__mark {
    color: var(--dim);
  }

  .hero__foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px 48px;
    flex-wrap: wrap;
    margin-top: clamp(8px, 2vh, 22px);
  }

  .hero__line {
    max-width: 36em;
    font-size: clamp(17px, 1.35vw, 21px);
    line-height: 1.5;
    color: var(--paper);
  }

  .hero__line :global(em) {
    font-style: normal;
    color: var(--yellow);
  }

  .hero__aside {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .hero__hint {
    font-size: 15px;
    color: var(--dim);
  }

  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font: 450 11px/1.4 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lilac);
  }

  .hero__scroll span {
    width: 1px;
    height: 30px;
    background: linear-gradient(var(--yellow), transparent);
    transform-origin: top;
    animation: drip 1.9s var(--ease-in-out) infinite;
  }

  @keyframes drip {
    0% {
      transform: scaleY(0);
      opacity: 1;
    }
    55% {
      transform: scaleY(1);
      opacity: 1;
    }
    100% {
      transform: scaleY(1);
      opacity: 0;
    }
  }

  @media (hover: none), (pointer: coarse) {
    .hero__hint {
      display: none;
    }
  }

  @media (max-width: 1080px) {
    .board__head,
    .dep {
      grid-template-columns: minmax(64px, 0.5fr) minmax(0, 1.8fr) minmax(0, 1.2fr);
    }

    .board__head span:nth-child(3),
    .dep :global(.dep__line) {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .hero {
      min-height: auto;
      padding-bottom: 56px;
    }

    .hero__clocks {
      gap: 18px;
    }

    .clock :global(.clock__time) {
      font-size: 18px;
    }

    .hero :global(.hero__name) {
      font-size: 21vw;
    }

    .hero :global(.hero__name .f.sp) {
      display: none;
    }

    .hero__dim span {
      right: 8px;
    }

    .hero :global(.hero__role) {
      font-size: 4.2vw;
    }

    .board__head {
      display: none;
    }

    .dep {
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 12px 12px;
    }

    .dep :global(.dep__year) {
      display: none;
    }

    .dep :global(.flap) {
      font-size: 4.2vw;
    }
  }
</style>
