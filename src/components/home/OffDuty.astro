---
import Icon from '../ui/Icon.astro';
import FlapText from '../ui/FlapText.astro';
import { Translator, type Locale } from '../../i18n/Translator';
import type { IconName } from '../ui/icons';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = new Translator(locale);
const l = t.life;

const now: { icon: IconName; title: string; text: string }[] = [
  { icon: 'shoe', title: l.hobbies.running, text: l.hobbies.runningText },
  { icon: 'dumbbell', title: l.hobbies.gym, text: l.hobbies.gymText },
  { icon: 'controller', title: l.hobbies.gaming, text: l.hobbies.gamingText }
];
const former: { icon: IconName; title: string }[] = [
  { icon: 'plate', title: l.hobbies.powerlifting },
  { icon: 'paddle', title: l.hobbies.tableTennis }
];

const rows = [
  ...now.map((hobby) => ({ ...hobby, former: false })),
  ...former.map((hobby) => ({ ...hobby, text: '', former: true }))
];
---

<section class="off section" id="off-duty" aria-labelledby="off-title">
  <div class="container">
    <div class="off__head">
      <h2 id="off-title" class="display h2" data-split set:html={l.title} />
      <p class="body-text" data-reveal>{l.text}</p>
    </div>

    <ol class="hobbies">
      {
        rows.map((hobby) => (
          <li class:list={['hobby', { 'hobby--former': hobby.former }]} data-deal="flip" data-flap-host>
            <Icon name={hobby.icon} size={30} strokeWidth={1.4} />
            <span class="hobby__title">{hobby.title}</span>
            <span class="hobby__text">{hobby.text}</span>
            <FlapText text={hobby.former ? l.former : l.current} tone={hobby.former ? 'dim' : 'yellow'} hover class="hobby__status" />
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .off__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: end;
    gap: 28px 64px;
  }

  .hobbies {
    margin-top: clamp(36px, 4vw, 56px);
  }

  /* one departure row per hobby: icon, name, note, now or formerly */
  .hobby {
    display: grid;
    grid-template-columns: 44px minmax(0, 0.7fr) minmax(0, 1.3fr) auto;
    align-items: center;
    gap: 10px 24px;
    padding: 14px 0;
    color: var(--lilac);
    background: linear-gradient(var(--line), var(--line)) left top / 100% 1px no-repeat;
  }

  .hobby:last-child {
    background:
      linear-gradient(var(--line), var(--line)) left top / 100% 1px no-repeat,
      linear-gradient(var(--line), var(--line)) left bottom / 100% 1px no-repeat;
  }

  .hobby :global(.icon) {
    color: var(--yellow);
  }

  .hobby--former :global(.icon) {
    color: var(--dim);
  }

  .hobby__title {
    font: 400 24px/1 var(--font-display);
    text-transform: uppercase;
    color: var(--paper);
  }

  .hobby__text {
    font-size: 16px;
  }

  .hobby :global(.hobby__status) {
    justify-self: end;
    --tw: 0.8;
    --th: 1.3;
    --gap: 0.08em;
    font-size: 22px;
  }

  @media (max-width: 900px) {
    .off__head {
      grid-template-columns: 1fr;
    }

    .hobby {
      grid-template-columns: 36px minmax(0, 1fr) auto;
    }

    .hobby__text {
      grid-column: 2 / -1;
    }

    .hobby :global(.hobby__status) {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
