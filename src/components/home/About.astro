---
import { Picture } from 'astro:assets';
import FlapText from '../ui/FlapText.astro';
import LineObjects from '../ui/LineObjects.astro';
import portrait from '../../assets/portrait.jpg';
import { Translator, type Locale } from '../../i18n/Translator';
import { profile } from '../../data/profile';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i18n = new Translator(locale);
const { t } = i18n;
const a = t.about;
const age = profile.ageOn();

const facts = [
  { label: a.facts.age, value: `<span data-age>${age}</span>` },
  { label: a.facts.born, value: a.facts.bornValue },
  { label: a.facts.heritage, value: a.facts.heritageValue },
  { label: a.facts.based, value: a.facts.basedValue },
  { label: a.facts.studying, value: a.facts.studyingValue }
];

const stops = [
  { code: 'CN', label: a.route.heritage, place: a.route.heritagePlace },
  { code: 'AUA', label: a.route.born, place: a.route.bornPlace },
  { code: 'RTM', label: a.route.now, place: a.route.nowPlace }
];
---

<section class="about section" id="about" aria-labelledby="about-title">
  <LineObjects
    items={[
      { icon: 'pi', x: 82, y: 2, size: 56, speed: 0.2, note: '3.14159' },
      { icon: 'integral', x: 50, y: 1.5, size: 48, speed: 0.15, accent: true }
    ]}
  />
  <div class="container">
    <div class="about__grid">
      <figure class="portrait" data-reveal>
        <span class="portrait__frame">
          <Picture
            src={portrait}
            formats={['avif', 'webp']}
            widths={[360, 560, 760]}
            sizes="(max-width: 960px) 80vw, 440px"
            alt={a.portraitAlt}
            loading="lazy"
            data-parallax-img
          />
        </span>
        <figcaption class="portrait__caption">
          <span>Bob Chung</span>
          <span>{a.facts.basedValue}</span>
        </figcaption>
      </figure>

      <div class="about__text">
        <h2 id="about-title" class="display h2" data-split set:html={a.title} />
        <p class="lead" data-reveal set:html={a.lead.replace('{age}', String(age))} />
        <p class="body-text" data-reveal>{a.body}</p>
        <blockquote class="about__quote" data-reveal>
          <p>{a.quote}</p>
        </blockquote>

        <dl class="facts" data-reveal>
          {
            facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd set:html={fact.value} />
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <div class="route" data-route aria-label={a.route.label} role="group">
      <p class="route__meta"><b>AUA → RTM</b> <span data-clock-diff data-template={a.clock.apart}></span></p>
      <svg class="route__svg" viewBox="0 0 1000 40" preserveAspectRatio="none" aria-hidden="true">
        <path class="route__base" d="M0 20 H1000" />
        <path class="route__line" d="M0 20 H1000" pathLength="1" data-route-line />
      </svg>
      <ol class="route__stops">
        {
          stops.map((stop) => (
            <li class="route__stop" data-route-stop>
              <FlapText text={stop.code} label="" class="route__code" />
              <span class="route__label">{stop.label}</span>
              <span class="route__place">{stop.place}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <p class="about__thought" data-reveal>
      <span class="about__thought-label">{a.thoughtLabel}</span>
      <span>{a.thought}</span>
    </p>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(260px, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(40px, 7vw, 120px);
    align-items: start;
  }

  .portrait {
    position: sticky;
    top: calc(var(--header-h) + 32px);
  }

  .portrait__frame {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    aspect-ratio: 4 / 5;
  }

  .portrait__frame :global(img) {
    width: 100%;
    height: 112%;
    object-fit: cover;
    object-position: 50% 20%;
    filter: grayscale(0.35) contrast(1.05);
    transition: filter 0.8s var(--ease-out);
  }

  .portrait:hover .portrait__frame :global(img) {
    filter: none;
  }

  /* dimension marks, as on a drawing */
  .portrait::before,
  .portrait::after {
    content: '';
    position: absolute;
    z-index: 1;
    width: 22px;
    height: 22px;
    border: solid var(--yellow);
    pointer-events: none;
  }

  .portrait::before {
    top: -10px;
    left: -10px;
    border-width: 2px 0 0 2px;
  }

  .portrait::after {
    right: -10px;
    bottom: 34px;
    border-width: 0 2px 2px 0;
  }

  .portrait__caption {
    display: flex;
    justify-content: space-between;
    padding-top: 12px;
    font: 450 11px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .about__text {
    display: grid;
    gap: 26px;
  }

  .about__quote {
    margin: 18px 0 4px;
  }

  .about__quote p::before {
    content: '“';
    color: var(--yellow);
  }

  .about__quote p::after {
    content: '”';
    color: var(--yellow);
  }

  .about__quote p {
    font: 700 clamp(28px, 3vw, 42px) / 1.04 var(--font-flap);
    text-transform: uppercase;
    color: var(--paper);
    text-wrap: balance;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0 28px;
    margin-top: 8px;
  }

  .facts div {
    display: grid;
    gap: 6px;
    padding: 16px 0;
    background: linear-gradient(var(--line-strong), var(--line-strong)) left top / 100% 1px no-repeat;
  }

  .facts dt {
    font: 450 11px/1.4 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .facts dd {
    font: 800 26px/1 var(--font-flap);
    text-transform: uppercase;
    color: var(--yellow);
  }

  /* the route Aruba to Rotterdam, drawn as the page scrolls */
  .route {
    position: relative;
    margin-top: clamp(56px, 6vw, 88px);
  }

  .route__meta {
    margin-bottom: 18px;
    font: 450 12px/1.5 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .route__meta b {
    margin-right: 12px;
    color: var(--yellow);
    font-weight: 450;
  }

  .route__svg {
    position: absolute;
    left: 0;
    right: 0;
    top: 51px;
    width: 100%;
    height: 40px;
    overflow: visible;
  }

  .route__base {
    stroke: var(--line-strong);
    stroke-width: 1;
    stroke-dasharray: 4 6;
    fill: none;
  }

  .route__line {
    stroke: var(--yellow);
    stroke-width: 2;
    fill: none;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  :global(html.motion-ready) .route__line {
    stroke-dashoffset: 1;
  }

  .route__stops {
    position: relative;
    display: flex;
    justify-content: space-between;
  }

  .route__stop {
    display: grid;
    gap: 8px;
    justify-items: start;
    padding-right: 12px;
    background: var(--board);
    opacity: 0.45;
    transition: opacity 0.5s var(--ease-out);
  }

  .route__stop:last-child {
    justify-items: end;
    text-align: right;
    padding: 0 0 0 12px;
  }

  .route__stop:nth-child(2) {
    justify-items: center;
    text-align: center;
    padding: 0 12px;
  }

  :global(html:not(.motion-ready)) .route__stop,
  .route__stop:global(.is-lit) {
    opacity: 1;
  }

  .route :global(.route__code) {
    --tw: 0.82;
    --th: 1.2;
    --gap: 0.08em;
    font-size: 44px;
  }

  .route__label {
    font: 450 11px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .route__place {
    font-size: 18px;
    font-weight: 600;
  }

  .about__thought {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 20px;
    margin-top: clamp(40px, 5vw, 64px);
    font-size: clamp(19px, 1.6vw, 23px);
    color: var(--lilac);
  }

  .about__thought-label {
    font-size: 15px;
    font-weight: 600;
    color: var(--dim);
  }

  @media (max-width: 960px) {
    .about__grid {
      grid-template-columns: 1fr;
    }

    .portrait {
      position: relative;
      top: 0;
      max-width: 420px;
    }
  }

  @media (max-width: 560px) {
    .route :global(.route__code) {
      font-size: 30px;
    }

    .route__place {
      font-size: 15px;
    }

    .route__label {
      font-size: 11px;
      max-width: 9em;
      line-height: 1.3;
    }
  }
</style>
