---
import FlapText from '../ui/FlapText.astro';
import { Translator, type Locale } from '../../i18n/Translator';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = new Translator(locale);
const c = t.career;
const pad = Math.max(c.currentStatus.length, c.hboStatus.length, c.nextStatus.length);
---

<section class="career section" id="career" aria-labelledby="career-title">
  <div class="container">
    <div class="career__grid">
      <div class="career__intro">
        <h2 id="career-title" class="display career__title" data-split set:html={c.title} />
        <p class="body-text" data-reveal>{c.roadmapNote}</p>
        <details class="why" data-reveal>
          <summary>
            <span>{c.whyToggle}</span>
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6l4 4 4-4" /></svg>
          </summary>
          <p>{c.why}</p>
        </details>
      </div>

      <ol class="service">
        <li class="service__row service__row--now" data-reveal data-flap-host>
          <FlapText text={c.currentStatus} pad={pad} hover class="service__status" />
          <div class="service__body">
            <h3 class="service__role">{c.currentRole}</h3>
            <p class="service__org">{c.currentOrg}</p>
            <p class="service__text">{c.currentText}</p>
          </div>
        </li>
        <li class="service__row service__row--study" data-reveal data-flap-host>
          <FlapText text={c.hboStatus} pad={pad} tone="paper" hover class="service__status" />
          <div class="service__body">
            <h3 class="service__role">{c.hboRole}</h3>
            <p class="service__org">{c.hboOrg}</p>
            <p class="service__text">{c.hboText}</p>
          </div>
        </li>
        <li class="service__row service__row--future" data-reveal>
          <details class="future" data-flap-host>
            <summary class="future__summary">
              <FlapText text={c.nextStatus} pad={pad} tone="lilac" label="" hover class="service__status" />
              <span class="future__label">
                <span class="service__role">{c.rolesToggle}</span>
                <span class="service__org">{c.roles.length} · {c.rolesHint}</span>
              </span>
              <span class="future__chevron" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6l4 4 4-4" /></svg>
              </span>
            </summary>
            <ul class="future__list">
              {
                c.roles.map((role) => (
                  <li class="future__item">
                    <h3 class="future__role">{role.title}</h3>
                    <p class="future__text">{role.text}</p>
                  </li>
                ))
              }
            </ul>
          </details>
        </li>
      </ol>
    </div>


  </div>
</section>

<style>
  .career__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 40px clamp(40px, 6vw, 96px);
    align-items: start;
  }

  .career__intro {
    display: grid;
    gap: 22px;
  }

  .career__title {
    font-size: clamp(44px, 5.4vw, 76px);
  }

  .service {
    display: grid;
  }

  .service__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 16px 28px;
    padding: 24px 0;
    background: linear-gradient(var(--line), var(--line)) left top / 100% 1px no-repeat;
  }

  .service__row:last-child {
    background:
      linear-gradient(var(--line), var(--line)) left top / 100% 1px no-repeat,
      linear-gradient(var(--line), var(--line)) left bottom / 100% 1px no-repeat;
  }

  .service :global(.service__status) {
    --tw: 0.86;
    --th: 1.45;
    --gap: 0.1em;
    font-size: 15px;
    align-self: start;
  }

  .service__body {
    display: grid;
    gap: 6px;
  }

  .service__role {
    font: 400 clamp(21px, 2vw, 28px) / 1 var(--font-display);
    text-transform: uppercase;
    color: var(--paper);
  }

  .service__row--now .service__role {
    color: var(--yellow);
  }

  .service__org {
    font: 450 11px/1.5 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  /* the possible future roles fold away behind one row */
  .service__row--future {
    display: block;
  }

  .future__summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: 16px 28px;
    list-style: none;
    cursor: pointer;
  }

  .future__summary::-webkit-details-marker {
    display: none;
  }

  .future__label {
    display: grid;
    gap: 6px;
  }

  .future__summary:hover .service__role {
    color: var(--yellow);
  }

  .future__chevron {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border: 1.5px solid var(--line-strong);
    border-radius: 50%;
    color: var(--yellow);
    transition: transform 0.45s var(--ease-out), background-color 0.3s, color 0.3s;
  }

  .future__summary:hover .future__chevron {
    background: var(--yellow);
    color: var(--on-yellow);
  }

  .future[open] .future__chevron {
    transform: rotate(180deg);
  }

  .future__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 28px;
    margin-top: 18px;
  }

  .future__item {
    display: grid;
    gap: 4px;
    align-content: start;
    padding: 14px 0;
    background: linear-gradient(var(--line), var(--line)) left top / 100% 1px no-repeat;
  }

  .future__role {
    font: 400 19px/1.05 var(--font-display);
    text-transform: uppercase;
    color: var(--paper);
  }

  .future__text {
    font-size: 15px;
    line-height: 1.5;
    color: var(--lilac);
  }

  .service__text {
    color: var(--lilac);
    font-size: 16px;
    max-width: 40em;
  }

  .why {
    margin-top: 4px;
    max-width: 52em;
  }

  .why summary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    list-style: none;
    font-weight: 600;
    color: var(--paper);
    padding-bottom: 4px;
    background: linear-gradient(var(--yellow), var(--yellow)) left bottom / 100% 2px no-repeat;
    cursor: pointer;
  }

  .why summary::-webkit-details-marker {
    display: none;
  }

  .why summary svg {
    color: var(--yellow);
    transition: transform 0.35s var(--ease-out);
  }

  .why[open] summary svg {
    transform: rotate(180deg);
  }

  .why p {
    margin-top: 16px;
    color: var(--lilac);
  }

  @media (max-width: 960px) {
    .career__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .future__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 520px) {
    .service__row {
      grid-template-columns: 1fr;
    }

    .future__summary {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .future__summary :global(.service__status) {
      grid-column: 1 / -1;
    }
  }
</style>
