---
import FlapText from '../ui/FlapText.astro';
import LineObjects from '../ui/LineObjects.astro';
import { Translator, type Locale } from '../../i18n/Translator';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = new Translator(locale);
const h = t.hood;
const codes = ['TS', 'C', 'PY'];
---

<section class="engine section" id="engine" aria-labelledby="engine-title">
  <LineObjects items={[{ icon: 'sqrt', x: 82, y: 6, size: 52, speed: 0.15, note: '√2' }]} />
  <div class="container">
    <div class="engine__head">
      <h2 id="engine-title" class="display engine__title" data-split set:html={h.title} />
      <p class="body-text" data-reveal>{h.intro}</p>
    </div>
    <ol class="engine__rows">
      {
        h.cards.map((card, index) => (
          <li class="engine__row" data-reveal data-flap-host>
            <FlapText text={codes[index]} label="" hover class="engine__code" />
            <h3 class="engine__name">{card.title}</h3>
            <p class="engine__lang">{card.lang}</p>
            <p class="engine__text">{card.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .engine__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px 64px;
    align-items: end;
    margin-bottom: clamp(36px, 4vw, 56px);
  }

  .engine__title {
    font-size: clamp(44px, 5.4vw, 76px);
  }

  /* one departure row per language: code tile, name, line, what it runs */
  .engine__row {
    display: grid;
    grid-template-columns: 96px minmax(0, 0.8fr) minmax(0, 0.7fr) minmax(0, 1.6fr);
    align-items: center;
    gap: 12px 28px;
    padding: 18px 0;
    background: linear-gradient(var(--line), var(--line)) left top / 100% 1px no-repeat;
  }

  .engine__row:last-child {
    background:
      linear-gradient(var(--line), var(--line)) left top / 100% 1px no-repeat,
      linear-gradient(var(--line), var(--line)) left bottom / 100% 1px no-repeat;
  }

  .engine :global(.engine__code) {
    --tw: 0.8;
    --th: 1.2;
    --gap: 0.08em;
    font-size: 34px;
  }

  .engine__name {
    font: 400 24px/1 var(--font-display);
    text-transform: uppercase;
  }

  .engine__lang {
    font: 450 12px/1.5 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--yellow);
  }

  .engine__text {
    color: var(--lilac);
    font-size: 16px;
  }

  @media (max-width: 900px) {
    .engine__head {
      grid-template-columns: 1fr;
    }

    .engine__row {
      grid-template-columns: 72px minmax(0, 1fr);
    }

    .engine__lang,
    .engine__text {
      grid-column: 2;
    }
  }
</style>
