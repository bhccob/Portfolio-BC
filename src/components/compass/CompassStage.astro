---
import { Picture } from 'astro:assets';
import pool from '../../assets/portrait-pool.webp';
import portrait from '../../assets/portrait.jpg';
import stillHero from '../../assets/renders/compass-hero.webp';
import stillChina from '../../assets/renders/compass-china.webp';
import stillAruba from '../../assets/renders/compass-aruba.webp';
import stillRotterdam from '../../assets/renders/compass-rotterdam.webp';
import stillDrive from '../../assets/renders/compass-drive.webp';
import stillOffduty from '../../assets/renders/compass-offduty.webp';
import CompassLoader from './CompassLoader.astro';
import Icon from '../ui/Icon.astro';
import type { IconName } from '../ui/icons';
import { Translator, type Locale } from '../../i18n/Translator';
import { profile } from '../../data/profile';
import { trackCopy, type TrackCopy } from '../../data/tracks';
import { SECTIONS, type SectionId } from '../../scripts/three/Choreography';
import { TRACKS, type TrackId } from '../../scripts/three/instrument/drive';

/*
 * The compass page: a scroll track with the WebGL stage stuck to the
 * viewport and one section per step of the choreography (SECTIONS), each as
 * many svh tall as its share of the scroll (the Q&A as tall as its content;
 * the controller measures them all), laid over the stage; a track's section
 * carries its TrackId as its id. Scripts (CompassStageController) light the
 * canvas and scrub the compass through the sections, and fade each section's
 * text by the choreography's `text` (`--shown`). Each section's text is a
 * sticky block of its own, a viewport tall, so it holds still while its
 * section scrolls and the fade does the rest: the hero has the name, the role
 * and two hints, About a heading and the lead, each home its label, the
 * current and its two lines what I work with, the change its caption, each
 * track its project (name, category, line and link), Off duty the hobbies,
 * and Say hello its link. The Q&A alone is no sticky block: it flows as a
 * column of questions (<details>) beside the small drive. Over the canvas,
 * decorative and placed by the controller each frame: the test point's label
 * at the read head, the hovered track's name at the pointer, and the Off duty
 * orbit of hobbies round the spindle. Without scripts, with reduced motion or
 * without WebGL, the stage is hidden and the sections read as a plain stacked
 * page, with the portrait and six stills of the compass (the hero, each home,
 * the drive after the change and the spindle after Off duty) to show what the
 * stage would. On the session's first visit the loader (CompassLoader) covers
 * it all until the live scene takes over.
 */

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i18n = new Translator(locale);
const { t } = i18n;
const c = t.compass;
const lead = t.about.lead.replace('{age}', String(profile.ageOn()));

/** The stills the stacked page shows, captured from the live scene, and their alt texts; a section without one shows none. */
const stills: Partial<Record<SectionId, typeof stillHero>> = {
  hero: stillHero,
  china: stillChina,
  aruba: stillAruba,
  rotterdam: stillRotterdam,
  change: stillDrive,
  offduty: stillOffduty
};
const alts: Partial<Record<SectionId, string>> = {
  hero: c.stills.hero,
  china: c.stills.china,
  aruba: c.stills.aruba,
  rotterdam: c.stills.rotterdam,
  change: c.stills.drive,
  offduty: c.stills.offduty
};

const isHome = (id: SectionId): id is 'china' | 'aruba' | 'rotterdam' => id === 'china' || id === 'aruba' || id === 'rotterdam';
const isTrack = (id: SectionId): id is TrackId => (TRACKS as readonly SectionId[]).includes(id);

/** What I work with: its two lines are the skills' foundation and AI rows. */
const lines: Partial<Record<SectionId, { title: string; text: string }>> = { stack: t.skills.rows[0], ai: t.skills.rows[2] };

const tracks = Object.fromEntries(TRACKS.map((id) => [id, trackCopy(id, locale)])) as Record<TrackId, TrackCopy>;
/** The read head's labels, per track and test point ("TP1 · LOG"), and the tracks' names for the hover label. */
const headLabels = Object.fromEntries(
  TRACKS.map((id) => [id, tracks[id].tps.map((label, k) => i18n.format(c.tp, { n: k + 1, label: label.toLocaleUpperCase(i18n.intlLocale) }))])
);
const trackNames = Object.fromEntries(TRACKS.map((id) => [id, tracks[id].name]));

const life = t.life;
const hobbies: { icon: IconName; name: string; text: string }[] = [
  { icon: 'shoe', name: life.hobbies.running, text: life.hobbies.runningText },
  { icon: 'dumbbell', name: life.hobbies.gym, text: life.hobbies.gymText },
  { icon: 'controller', name: life.hobbies.gaming, text: life.hobbies.gamingText }
];
const former = `${life.former}: ${life.hobbies.powerlifting} · ${life.hobbies.tableTennis}`;
/** The orbit round the spindle, the faint former hobbies between the current ones. */
const orbit: { icon: IconName; former: boolean }[] = [
  { icon: 'shoe', former: false },
  { icon: 'plate', former: true },
  { icon: 'dumbbell', former: false },
  { icon: 'paddle', former: true },
  { icon: 'controller', former: false }
];

/** The Q&A's answers, in the questions' order, from the career copy: a label, paragraphs, then terms with their text. */
const career = t.career;
const answers: { label?: string; paragraphs: readonly string[]; terms?: { term: string; text: string; sector?: boolean }[] }[] = [
  { label: `${career.currentRole} · ${career.currentOrg}`, paragraphs: [career.currentText] },
  { paragraphs: [career.hboText] },
  {
    paragraphs: [career.roadmapNote],
    terms: [
      ...career.roleGroups.flatMap((group) => group.roles.map((role) => ({ term: role.title, text: role.text }))),
      { term: career.sector.title, text: career.sector.text, sector: true }
    ]
  },
  { paragraphs: career.why },
  { paragraphs: [career.goalText] }
];
const questions = c.qa.items.map((question, k) => ({ question, answer: answers[k] }));
---

<CompassLoader locale={locale} />
<div class="compass" data-compass-track>
  <div class="compass__stage" data-compass-stage data-portrait={pool.src}>
    <canvas class="compass__canvas" data-compass-canvas aria-hidden="true"></canvas>
    <div class="compass__orbit" data-compass-orbit aria-hidden="true">
      <span class="compass__orbit-ring"></span>
      {
        orbit.map(({ icon, former: faint }) => (
          <span class:list={['compass__orbit-icon', { 'compass__orbit-icon--former': faint }]}>
            <Icon name={icon} size={34} strokeWidth={1.5} />
          </span>
        ))
      }
    </div>
    <div class="compass__label compass__label--head" data-compass-head data-labels={JSON.stringify(headLabels)} aria-hidden="true"></div>
    <div class="compass__label compass__label--hover" data-compass-hover data-names={JSON.stringify(trackNames)} aria-hidden="true"></div>
  </div>
  {
    SECTIONS.map(({ id, length }) => {
      const line = lines[id];
      const track = isTrack(id) ? tracks[id] : null;
      return (
        <section class="compass__section" data-section={id} id={isTrack(id) ? id : undefined} style={length === null ? undefined : `--len: ${length}`}>
          <div class="compass__text">
            <div class="compass__copy">
              {id === 'hero' && (
                <>
                  <h1 class="title compass__name">{profile.name}</h1>
                  <p class="hud-label compass__role">{c.role}</p>
                  <p class="hud-label compass__hints">
                    <span>{c.hints.scroll}</span>
                    <span aria-hidden="true">{c.hints.drag}</span>
                  </p>
                </>
              )}
              {id === 'about' && (
                <>
                  <h2 class="title compass__heading">{c.about.title}</h2>
                  <p class="lead compass__lead" set:html={lead} />
                </>
              )}
              {isHome(id) && <h3 class="title compass__heading">{c.homes[id]}</h3>}
              {id === 'current' && (
                <>
                  <h2 class="title compass__heading">{c.work.title}</h2>
                  <p class="hud-label compass__caption">{c.work.caption}</p>
                </>
              )}
              {line && (
                <>
                  <h3 class="title compass__heading">{line.title}</h3>
                  <p class="compass__line">{line.text}</p>
                </>
              )}
              {id === 'change' && <p class="title compass__heading compass__heading--caption">{c.change}</p>}
              {track && (
                <>
                  {id === 'funcial' && <h2 class="compass__hidden">{c.projects}</h2>}
                  <h3 class="title compass__heading">{track.name}</h3>
                  <p class="hud-label compass__meta">{[track.category, track.kind].filter(Boolean).join(' · ')}</p>
                  <p class="compass__line">{track.line}</p>
                  {track.link && (
                    <a
                      class="compass__link"
                      href={track.link.href}
                      data-track-link
                      target={track.link.external ? '_blank' : undefined}
                      rel={track.link.external ? 'noopener noreferrer' : undefined}
                    >
                      {track.link.label}
                      <Icon name="arrow" size={14} strokeWidth={1.8} />
                    </a>
                  )}
                </>
              )}
              {id === 'offduty' && (
                <>
                  <h2 class="title compass__heading">{c.offduty.title}</h2>
                  <p class="compass__spin">{c.offduty.spin}</p>
                  <ul class="compass__hobbies">
                    {hobbies.map((hobby) => (
                      <li class="compass__hobby">
                        <Icon name={hobby.icon} size={26} strokeWidth={1.5} />
                        <span class="compass__hobby-name">{hobby.name}</span>
                        <span class="compass__hobby-text">{hobby.text}</span>
                      </li>
                    ))}
                  </ul>
                  <p class="hud-label compass__former">{former}</p>
                </>
              )}
              {id === 'qa' && (
                <>
                  <h2 class="title compass__heading">{c.qa.title}</h2>
                  <div class="compass__questions">
                    {questions.map(({ question, answer }, k) => (
                      <details class="compass__question" data-question={k}>
                        <summary>{question}</summary>
                        <div class="compass__answer">
                          {answer.label && <p class="hud-label compass__answer-label">{answer.label}</p>}
                          {answer.paragraphs.map((paragraph) => (
                            <p>{paragraph}</p>
                          ))}
                          {answer.terms && (
                            <dl class="compass__terms">
                              {answer.terms.map(({ term, text, sector }) => (
                                <div class:list={['compass__term', { 'compass__term--sector': sector }]}>
                                  <dt>{term}</dt>
                                  <dd>{text}</dd>
                                </div>
                              ))}
                            </dl>
                          )}
                        </div>
                      </details>
                    ))}
                  </div>
                </>
              )}
              {id === 'hello' && (
                <h2 class="title compass__hello">
                  <a href={i18n.path('/contact/')}>{c.hello}</a>
                </h2>
              )}
            </div>
          </div>
          {id === 'about' ? (
            <figure class="compass__portrait">
              <Picture
                src={portrait}
                formats={['avif', 'webp']}
                widths={[280, 560]}
                sizes="280px"
                alt={t.about.portraitAlt}
                loading="lazy"
                decoding="async"
              />
            </figure>
          ) : (
            stills[id] && (
              <Picture
                pictureAttributes={{ class: 'compass__still' }}
                src={stills[id]}
                formats={['webp']}
                fallbackFormat="webp"
                widths={[800, 1600]}
                sizes="(min-width: 1164px) 1100px, 100vw"
                alt={alts[id] ?? ''}
                loading={id === 'hero' ? 'eager' : 'lazy'}
                decoding="async"
              />
            )
          )}
        </section>
      );
    })
  }
</div>

<style>
  /* ---------- stacked: the page without scripts, motion or WebGL ---------- */
  .compass__stage {
    display: none;
  }

  .compass__section {
    display: grid;
    gap: clamp(24px, 4svh, 40px);
    align-content: start;
    max-width: 1100px;
    margin-inline: auto;
    padding: clamp(40px, 8svh, 96px) var(--gutter);
  }

  .compass__section:first-of-type {
    padding-top: clamp(64px, 12svh, 128px);
  }

  .compass__copy {
    display: grid;
    justify-items: start;
    gap: 16px;
  }

  .compass__name {
    font-size: clamp(44px, 9vw, 136px);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: 0.01em;
    color: var(--yellow);
    text-transform: uppercase;
  }

  .compass__role {
    color: var(--cream);
    text-wrap: balance;
  }

  /* The hints speak of the live stage (scrolling it, turning the dial), which the stacked page has not. */
  .compass__hints {
    display: none;
    flex-wrap: wrap;
    gap: 6px 28px;
    margin-top: 10px;
    color: var(--lilac);
  }

  .compass__heading {
    font-size: clamp(28px, 4.6vw, 52px);
    font-weight: 600;
    text-wrap: balance;
  }

  /* The change's one sentence is a caption, not a heading: about a small heading's size, so it sits in three lines. */
  .compass__heading--caption {
    font-size: clamp(22px, 2.8vw, 34px);
    line-height: 1.15;
  }

  .compass__lead {
    max-width: 34em;
  }

  /* The drive's words: a caption, a line of text, a project's category and kind, its link. */
  .compass__caption,
  .compass__meta {
    color: var(--gold);
  }

  .compass__line {
    max-width: 34em;
    font-size: clamp(16px, 1.25vw, 19px);
    line-height: 1.55;
    color: var(--cream);
    text-wrap: pretty;
  }

  .compass__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 0;
    font-family: var(--font-hud);
    font-size: var(--hud-size);
    font-weight: 500;
    letter-spacing: var(--hud-tracking);
    text-transform: uppercase;
    color: var(--yellow);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 7px;
  }

  .compass__link :global(.icon) {
    transition: transform 0.25s var(--ease-out);
  }

  .compass__link:hover :global(.icon),
  .compass__link:focus-visible :global(.icon) {
    transform: translate(2px, -2px);
  }

  /* The projects' heading, for the outline and screen readers: the tracks' names say it on screen. */
  .compass__hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* Off duty: what keeps me spinning, the three hobbies now, the two before. */
  .compass__spin {
    font-size: clamp(18px, 1.4vw, 22px);
    line-height: 1.4;
    color: var(--cream);
  }

  .compass__hobbies {
    display: grid;
    gap: 14px;
    justify-self: stretch;
  }

  .compass__hobby {
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr);
    column-gap: 14px;
    row-gap: 2px;
  }

  .compass__hobby :global(.icon) {
    grid-row: span 2;
    color: var(--gold);
  }

  .compass__hobby-name {
    font-family: var(--font-title);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--cream);
  }

  .compass__hobby-text {
    font-size: 15px;
    line-height: 1.45;
  }

  /* The Q&A: plain <details>, a question to a row, its answer from the career copy. */
  .compass__questions {
    display: grid;
    justify-self: stretch;
    max-width: 640px;
  }

  /*
   * The rules between the questions are their summaries' and their answers'
   * own, so they fade with the words as these rise under the drive (below):
   * one above each question, and the closing one under the last question, or
   * under its answer while that is open.
   */
  .compass__question summary,
  .compass__question:last-child[open] .compass__answer > :last-child {
    border-color: rgb(184 170 216 / 0.2);
    border-style: solid;
    border-width: 0;
  }

  .compass__question summary {
    border-top-width: 1px;
  }

  .compass__question:last-child:not([open]) summary,
  .compass__question:last-child[open] .compass__answer > :last-child {
    border-bottom-width: 1px;
  }

  .compass__question:last-child[open] .compass__answer {
    padding-bottom: 0;
  }

  .compass__question:last-child[open] .compass__answer > :last-child {
    padding-bottom: 24px;
  }

  .compass__question summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 18px 0;
    font-family: var(--font-title);
    font-size: clamp(17px, 1.3vw, 21px);
    font-weight: 500;
    line-height: 1.3;
    color: var(--cream);
    list-style: none;
    cursor: pointer;
  }

  .compass__question summary::-webkit-details-marker {
    display: none;
  }

  /* A plus drawn in gold, turned to a cross while the answer is open; empty content, so nothing of it is read out. */
  .compass__question summary::after {
    content: '';
    flex: none;
    width: 14px;
    height: 14px;
    background:
      linear-gradient(var(--gold), var(--gold)) center / 100% 1.5px no-repeat,
      linear-gradient(var(--gold), var(--gold)) center / 1.5px 100% no-repeat;
    transition: transform 0.3s var(--ease-out);
  }

  .compass__question[open] summary::after {
    transform: rotate(45deg);
  }

  .compass__question summary:hover {
    color: var(--yellow);
  }

  .compass__answer {
    display: grid;
    gap: 14px;
    max-width: 36em;
    padding-bottom: 24px;
    font-size: 16px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .compass__answer-label {
    color: var(--gold);
  }

  .compass__terms {
    display: grid;
    gap: 14px;
  }

  .compass__term dt {
    font-family: var(--font-title);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--cream);
  }

  .compass__term dd {
    margin-top: 2px;
  }

  .compass__term--sector {
    padding-top: 14px;
    border-top: 1px solid rgb(184 170 216 / 0.2);
  }

  .compass__term--sector dt {
    color: var(--gold);
  }

  /* Say hello: the contact page, in the name's own size and yellow. */
  .compass__hello {
    font-size: clamp(44px, 9vw, 136px);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .compass__hello a {
    color: var(--yellow);
    text-decoration: none;
  }

  .compass__hello a:hover {
    text-decoration: underline;
    text-decoration-thickness: 0.05em;
    text-underline-offset: 0.12em;
  }

  .compass__portrait {
    width: min(100%, 280px);
  }

  .compass__portrait :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: 12px;
  }

  .compass__section :global(.compass__still) {
    display: block;
  }

  .compass__section :global(.compass__still img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 12px;
    background: #07040d;
  }

  /* About: the words and the portrait side by side when there is room, the DOM order (words, then portrait) kept. */
  @media (min-width: 760px) {
    .compass__section[data-section='about'] {
      grid-template-columns: minmax(0, 1fr) 280px;
      column-gap: clamp(32px, 6vw, 96px);
      align-items: start;
    }
  }

  /*
   * ---------- live: the stage sticks to the viewport while the sections scroll over it ----------
   * The stage paints the studio's own black under the canvas, so the wait
   * for the scene's first frame shows no seam, and takes back its own height
   * (margin-bottom: -100svh), so the sections start at the top of the track.
   * The track is then the sections' lengths plus a last viewport, and its
   * scroll runs over exactly SECTIONS' lengths. js-motion is set before first
   * paint and taken off again if the compass module never runs (BenchLayout's
   * failsafe), so this layout never waits on a script that is not coming.
   */
  :global(.js-motion) .compass__stage:not([data-fallback]) {
    display: block;
    position: sticky;
    top: 0;
    height: 100svh;
    margin-bottom: -100svh;
    overflow: hidden;
    /* CompassStudio's clear colour. */
    background: #07040d;
    /* A vertical swipe scrolls the page and two fingers zoom it; a mostly horizontal drag turns the dial. */
    touch-action: pan-y pinch-zoom;
  }

  /* A drag across the canvas turns the dial rather than selecting. */
  :global(.js-motion) .compass__stage:not([data-fallback]) .compass__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    -webkit-user-select: none;
    user-select: none;
  }

  /*
   * The overlays on the canvas, decorative and out of the pointer's way, placed
   * after every frame by the controller in canvas px (--x, --y, from the
   * scene's overlay()) and shown by `data-shown`: the test point's label up
   * and right of the read head, the hovered track's name up and right of the
   * pointer, and the Off duty orbit centred on the spindle, --r px out and
   * turned with the platter (--a, degrees counter-clockwise; CSS turns
   * clockwise), each icon turned back so it stays upright, its opacity Off
   * duty's text (--shown). No transition on the orbit's turn: --a can jump a
   * whole turn.
   */
  .compass__orbit,
  .compass__label {
    position: absolute;
    left: 0;
    top: 0;
    pointer-events: none;
    opacity: 0;
  }

  .compass__label {
    font-family: var(--font-hud);
    font-size: var(--hud-size);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: var(--hud-tracking);
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--gold);
    text-shadow:
      0 0 2px rgb(7 4 13 / 0.9),
      0 0 10px rgb(7 4 13 / 0.9);
    transition: opacity 0.2s var(--ease-out);
  }

  .compass__label[data-shown] {
    opacity: 1;
  }

  .compass__label--head {
    transform: translate(calc(var(--x, 0) * 1px + 18px), calc(var(--y, 0) * 1px - 100% - 18px));
  }

  /* A leader from the head's point to the label's lower left corner. */
  .compass__label--head::before {
    content: '';
    position: absolute;
    left: -18px;
    bottom: -18px;
    width: 25.5px;
    height: 1px;
    background: currentColor;
    opacity: 0.7;
    transform: rotate(-45deg);
    transform-origin: 0 50%;
  }

  .compass__label--hover {
    transform: translate(calc(var(--x, 0) * 1px + 14px), calc(var(--y, 0) * 1px - 100% - 10px));
  }

  /* A label that would run off the canvas's right edge stands up and left of its point instead (`data-flip`). */
  .compass__label--head[data-flip] {
    transform: translate(calc(var(--x, 0) * 1px - 100% - 18px), calc(var(--y, 0) * 1px - 100% - 18px));
  }

  .compass__label--head[data-flip]::before {
    left: auto;
    right: -18px;
    transform: rotate(45deg);
    transform-origin: 100% 50%;
  }

  .compass__label--hover[data-flip] {
    transform: translate(calc(var(--x, 0) * 1px - 100% - 14px), calc(var(--y, 0) * 1px - 100% - 10px));
  }

  .compass__orbit {
    width: 0;
    height: 0;
    color: var(--gold);
    transform: translate(calc(var(--x, 0) * 1px), calc(var(--y, 0) * 1px)) rotate(calc(-1deg * var(--a, 0)));
  }

  .compass__orbit[data-shown] {
    opacity: var(--shown, 0);
  }

