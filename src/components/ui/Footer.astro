---
import { Translator, type Locale } from '../../i18n/Translator';
import { profile } from '../../data/profile';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = new Translator(locale);
const year = new Date().getFullYear();
// Mentioned only when the cookie-free analytics beacon is actually on (see BaseLayout).
const analytics = Boolean(import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN);
---

<footer class="site-footer">
  <div class="container site-footer__row">
    <p class="site-footer__made">
      <img class="site-footer__mark" src="/favicon.svg" width="30" height="30" alt="" />
      <span>
        © <span data-year>{year}</span> {profile.name} · {t.footer.made}
        {analytics && <span class="site-footer__stats">{t.footer.analytics}</span>}
      </span>
    </p>
    <ul class="site-footer__links">
      {
        profile.socials.map((social) => (
          <li>
            <a href={social.url} target={social.id === 'email' ? undefined : '_blank'} rel={social.id === 'email' ? undefined : 'noopener noreferrer'}>
              {social.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="site-footer__hint" set:html={t.footer.terminalHint} />
    <a class="site-footer__top" href="#top">
      {t.footer.top}
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 13V3M4 7l4-4 4 4" /></svg>
    </a>
  </div>
</footer>

<style>
  .site-footer {
    padding: 28px 0 32px;
    background: linear-gradient(var(--line-strong), var(--line-strong)) left top / 100% 1px no-repeat;
  }

  .site-footer__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 18px 36px;
    color: var(--lilac);
    font-size: 15px;
  }

  .site-footer__made {
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }

  /* the ping-pong ball monogram, the same mark as the browser tab */
  .site-footer__mark {
    flex: none;
    border-radius: 6px;
  }

  .site-footer__stats {
    display: block;
    font-size: 13px;
    color: var(--dim);
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 26px;
  }

  .site-footer__links a {
    color: var(--paper);
    background: linear-gradient(var(--yellow), var(--yellow)) left bottom / 0 2px no-repeat;
    padding-bottom: 3px;
    transition: background-size 0.4s var(--ease-out);
  }

  .site-footer__links a:hover {
    background-size: 100% 2px;
  }

  .site-footer__hint {
    font-size: 14px;
    color: var(--dim);
  }

  .site-footer__hint :global(kbd) {
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 24px;
    margin: 0 4px;
    font: 800 15px/1 var(--font-flap);
    color: var(--yellow);
    background: linear-gradient(var(--tile-hi), var(--tile) 50%, var(--split) 50%, var(--split) calc(50% + 1px), var(--tile-2) calc(50% + 1px));
    border-radius: 3px;
  }

  .site-footer__top {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 450 12px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lilac);
    transition: color 0.3s;
  }

  .site-footer__top:hover {
    color: var(--yellow);
  }

  @media (hover: none) {
    .site-footer__hint {
      display: none;
    }
  }
</style>
