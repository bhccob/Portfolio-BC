---
/**
 * Text set as split-flap tiles. The tiles are drawn entirely in CSS from
 * `data-c` / `data-b` attributes, so the board reads correctly without
 * JavaScript and the characters never appear twice in the page text. The
 * real words sit in a visually hidden span for screen readers and crawlers.
 * `FlapBoard` (src/scripts/ui/FlapBoard.ts) brings the tiles to life.
 *
 * Tiles are grouped per word, so a row marked `wrap` breaks between words
 * on narrow screens instead of in the middle of one.
 */
interface Props {
  text: string;
  /** Element to render: a heading keeps its semantics. */
  as?: 'span' | 'h1' | 'h2' | 'h3' | 'p' | 'div';
  tone?: 'yellow' | 'lilac' | 'paper' | 'dim';
  /** Pad with blank tiles to this many characters, so a row can flip to longer text. */
  pad?: number;
  /** Accessible text when it differs from the tiles (e.g. a time). Empty string hides it. */
  label?: string;
  class?: string;
  id?: string;
  /** `intro` flips in on load, `view` flips when scrolled into view, `none` stays put. */
  play?: 'intro' | 'view' | 'none';
  /** Re-flip the row when it (or its link) is hovered. */
  hover?: boolean;
  /** Allow the row to break between words. */
  wrap?: boolean;
  /** Extra attributes, e.g. a `data-*` hook. */
  [key: `data-${string}`]: string | undefined;
}

const { text, as: Tag = 'span', tone = 'yellow', pad = 0, label, class: className, id, play = 'view', hover = false, wrap = false, ...rest } = Astro.props;
const chars = [...text.toUpperCase().padEnd(pad, ' ')];
const spoken = label ?? text;

// Group the characters into words; every space becomes its own tile between groups.
const groups: string[][] = [];
let current: string[] = [];
for (const char of chars) {
  if (char === ' ') {
    if (current.length) groups.push(current);
    groups.push([' ']);
    current = [];
  } else {
    current.push(char);
  }
}
if (current.length) groups.push(current);
---

<Tag
  id={id}
  class:list={['flap', `flap--${tone}`, { 'flap--wrap': wrap }, className]}
  data-flap={play}
  data-flap-hover={hover ? '' : undefined}
  {...rest}
>
  {spoken && <span class="visually-hidden">{spoken}</span>}
  <span class="flap__tiles" aria-hidden="true">
    {
      groups.map((group) =>
        group[0] === ' ' ? (
          <span class="f sp" data-c=" " data-b=" " />
        ) : (
          <span class="w">{group.map((char) => <span class="f" data-c={char} data-b={char} />)}</span>
        )
      )
    }
  </span>
</Tag>
