---
import { Translator, type Locale } from '../../i18n/Translator';
import { projects } from '../../data/projects';
import { profile } from '../../data/profile';

interface Props {
  locale: Locale;
  age: number;
}

const { locale, age } = Astro.props;
const i18n = new Translator(locale);
const { t } = i18n;

/** Everything the client-side shell needs, localized at build time. */
const config = {
  strings: { ...t.terminal, whoami: i18n.format(t.terminal.whoami, { age }) },
  routes: {
    home: i18n.path('/'),
    contact: i18n.path('/contact/'),
    en: Translator.pathFor('en', '/'),
    nl: Translator.pathFor('nl', '/')
  },
  projects: projects.all().map((project) => ({
    label: project.label,
    title: project.title,
    type: project.copy(locale).type,
    url: i18n.path(project.route())
  })),
  socials: profile.socials.map((social) => ({ label: social.label, handle: social.handle, url: social.url }))
};
---

<dialog class="terminal" data-terminal data-config={JSON.stringify(config)} aria-labelledby="terminal-title">
  <div class="terminal__bar">
    <span class="terminal__lights" aria-hidden="true"><i></i><i></i><i></i></span>
    <p id="terminal-title" class="mono">{t.terminal.title}</p>
    <button type="button" class="terminal__close mono" data-terminal-close aria-label={t.nav.close}>esc</button>
  </div>
  <div class="terminal__log mono" data-terminal-log role="log" aria-live="polite"></div>
  <form class="terminal__form" data-terminal-form autocomplete="off">
    <label class="terminal__prompt mono" for="terminal-input">bob@rotterdam:~$</label>
    <input id="terminal-input" class="mono" type="text" spellcheck="false" autocapitalize="off" placeholder={t.terminal.placeholder} data-terminal-input />
  </form>
</dialog>

<style>
  .terminal {
    width: min(680px, calc(100vw - 32px));
    max-height: min(560px, calc(100svh - 64px));
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: rgb(14 7 25 / 0.97);
    color: var(--paper);
    box-shadow:
      0 40px 120px rgb(0 0 0 / 0.55),
      0 0 0 1px rgb(255 207 51 / 0.1);
    overflow: hidden;
  }

  .terminal[open] {
    display: flex;
    flex-direction: column;
    animation: term-in 0.4s var(--ease-out);
  }

  .terminal::backdrop {
    background: rgb(20 10 36 / 0.65);
    backdrop-filter: blur(4px);
  }

  @keyframes term-in {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.97);
    }
  }

  .terminal__bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    color: var(--lilac);
  }

  .terminal__bar p.mono {
    flex: 1;
    font-size: 11px;
    text-transform: none;
    letter-spacing: 0.04em;
  }

  .terminal__lights {
    display: flex;
    gap: 6px;
  }

  .terminal__lights i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--board-3);
  }

  .terminal__lights i:first-child {
    background: var(--yellow);
  }

  .terminal__close {
    padding: 4px 8px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font-size: 11px;
    color: var(--lilac);
  }

  .terminal__log {
    flex: 1;
    min-height: 220px;
    padding: 16px 18px 4px;
    overflow-y: auto;
    font-size: 13px;
    line-height: 1.7;
    letter-spacing: 0.01em;
    text-transform: none;
    white-space: pre-wrap;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--board-3) transparent;
  }

  .terminal__log :global(.cmd) {
    color: var(--lilac);
  }

  .terminal__log :global(.cmd b) {
    color: var(--yellow);
    font-weight: 500;
  }

  .terminal__log :global(.ok) {
    color: #8ff0a4;
  }

  .terminal__log :global(.err) {
    color: #ff8fa3;
  }

  .terminal__log :global(a) {
    color: var(--yellow);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .terminal__log :global(.dim) {
    color: var(--dim);
  }

  .terminal__form {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px 16px;
  }

  .terminal__prompt {
    color: var(--yellow);
    font-size: 13px;
    text-transform: none;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .terminal__form input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    font-size: 13px;
    text-transform: none;
    letter-spacing: 0.01em;
    caret-color: var(--yellow);
  }

  .terminal__form input:focus {
    outline: none;
  }

  .terminal__form input::placeholder {
    color: var(--dim);
  }

  @media (max-width: 520px) {
    .terminal__prompt {
      display: none;
    }
  }
</style>
