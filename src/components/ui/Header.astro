---
import FlapText from './FlapText.astro';
import { Translator, type Locale } from '../../i18n/Translator';

interface Props {
  locale: Locale;
  route: string;
}

const { locale, route } = Astro.props;
const i18n = new Translator(locale);
const { t } = i18n;
const home = i18n.path('/');
const contact = i18n.path('/contact/');
const alternates = i18n.alternates(route);
const links = [
  { href: `${home}#work`, label: t.nav.work },
  { href: `${home}#about`, label: t.nav.about },
  { href: `${home}#career`, label: t.nav.career }
];
---

<header class="site-header" data-site-header>
  <div class="site-header__bar">
    <a class="brand" href={home} aria-label={t.nav.home}>Bob Chung</a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {links.map((link) => <li><a class="site-nav__link" href={link.href}>{link.label}</a></li>)}
        <li><a class="site-nav__link" href={contact}>{t.nav.contact}</a></li>
      </ul>
    </nav>

    <div class="header-tools">
      <button class="tool" type="button" data-terminal-open aria-label={t.nav.terminal} title={t.nav.terminal}>
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 5l5 5-5 5M10 15h7" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      <div class="lang" role="group" aria-label={t.nav.language}>
        <a href={alternates.en} hreflang="en" lang="en" aria-current={locale === 'en' ? 'true' : undefined} aria-label={locale === 'en' ? 'English' : t.nav.switchTo}>EN</a>
        <a href={alternates.nl} hreflang="nl" lang="nl" aria-current={locale === 'nl' ? 'true' : undefined} aria-label={locale === 'nl' ? 'Nederlands' : t.nav.switchTo}>NL</a>
      </div>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="visually-hidden" data-menu-label data-open-label={t.nav.menu} data-close-label={t.nav.close}>{t.nav.menu}</span>
        <span class="menu-btn__line" aria-hidden="true"></span>
        <span class="menu-btn__line" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
  <nav aria-label="Mobile">
    <ol>
      {
        [...links, { href: contact, label: t.nav.contact }].map((link, index) => (
          <li style={`--i:${index}`}>
            <a href={link.href} data-menu-link>
              <span class="mobile-menu__num">0{index + 1}</span>
              <FlapText text={link.label} play="none" label={link.label} class="mobile-menu__flap" />
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
  <p class="mobile-menu__foot">bob@rotterdam:~$ <span class="yellow">_</span></p>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 80;
    padding: 12px clamp(10px, 1.4vw, 18px) 0;
    transition: transform 0.5s var(--ease-out);
    pointer-events: none;
  }

  .site-header.is-hidden {
    transform: translateY(-110%);
  }

  /* an outlined bar, like a label stuck on the top of the sheet */
  .site-header__bar {
    height: 60px;
    padding: 0 10px 0 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius-card);
    background: var(--board);
    pointer-events: auto;
    transition: border-color 0.4s;
  }

  .site-header.is-scrolled .site-header__bar {
    border-color: rgb(244 236 218 / 0.5);
  }

  .brand {
    font: 400 32px/1 var(--font-script);
    color: var(--paper);
    transform: rotate(-4deg) translateY(-1px);
    transition: color 0.3s, transform 0.4s var(--ease-out);
  }

  .brand:hover {
    color: var(--yellow);
    transform: rotate(-7deg) scale(1.04);
  }

  .site-nav {
    margin-left: auto;
  }

  .site-nav ul {
    display: flex;
    gap: 30px;
  }

  .site-nav__link {
    position: relative;
    display: block;
    padding: 8px 0;
    font: 800 15px/1 var(--font-sans);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--paper);
    transition: color 0.3s;
  }

  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--yellow);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease-out);
  }

  .site-nav__link:hover,
  .site-nav__link.is-active {
    color: var(--yellow);
  }

  .site-nav__link:hover::after,
  .site-nav__link.is-active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header-tools {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-left: 18px;
    margin-left: 6px;
    background: linear-gradient(var(--line-strong), var(--line-strong)) left center / 1px 26px no-repeat;
  }

  .tool {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    color: var(--lilac);
    border-radius: var(--radius);
    transition: color 0.3s, background-color 0.3s;
  }

  .tool:hover {
    color: var(--on-yellow);
    background: var(--yellow);
  }

  .lang {
    display: flex;
    gap: 4px;
    font: 800 13px/1 var(--font-sans);
    letter-spacing: 0.06em;
  }

  .lang a {
    display: grid;
    place-items: center;
    width: 34px;
    height: 32px;
    color: var(--dim);
    border-radius: var(--radius);
    transition: color 0.3s, background-color 0.3s;
  }

  .lang a:hover {
    color: var(--paper);
  }

  .lang a[aria-current='true'] {
    color: var(--on-yellow);
    background: var(--yellow);
  }

  .menu-btn {
    position: relative;
    display: none;
    width: 44px;
    height: 44px;
  }

  .menu-btn__line {
    position: absolute;
    left: 11px;
    right: 11px;
    height: 2px;
    background: var(--paper);
    transition: transform 0.45s var(--ease-out);
  }

  .menu-btn__line:nth-of-type(2) {
    transform: translateY(-4px);
  }

  .menu-btn__line:nth-of-type(3) {
    transform: translateY(4px);
  }

  .menu-btn[aria-expanded='true'] .menu-btn__line:nth-of-type(2) {
    transform: rotate(45deg);
  }

  .menu-btn[aria-expanded='true'] .menu-btn__line:nth-of-type(3) {
    transform: rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 79;
    padding: calc(var(--header-h) + 36px) var(--gutter) 32px;
    background: var(--board-deep);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.7s var(--ease-in-out);
  }

  .mobile-menu.is-open {
    clip-path: inset(0 0 0 0);
  }

  .mobile-menu ol {
    display: grid;
    gap: 14px;
  }

  .mobile-menu a {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 6px 0;
  }

  .mobile-menu li {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.5s var(--ease-out), transform 0.6s var(--ease-out);
    transition-delay: calc(0.18s + var(--i) * 70ms);
  }

  .mobile-menu.is-open li {
    opacity: 1;
    transform: none;
  }

  .mobile-menu__num {
    font: 450 12px/1 var(--font-mono);
    color: var(--dim);
    letter-spacing: 0.1em;
  }

  .mobile-menu :global(.mobile-menu__flap) {
    --tw: 0.72;
    --th: 1.2;
    --gap: 0.08em;
    font-size: clamp(34px, 11vw, 54px);
  }

  .mobile-menu__foot {
    font: 450 12px/1 var(--font-mono);
    color: var(--dim);
  }

  @media (max-width: 960px) {
    .site-nav {
      display: none;
    }

    .header-tools {
      margin-left: auto;
      background: none;
    }

    .menu-btn {
      display: block;
    }
  }

  @media (max-width: 420px) {
    .tool {
      display: none;
    }
  }
</style>
