---
import FlapText from '../ui/FlapText.astro';
import { Translator, type Locale } from '../../i18n/Translator';
import { profile } from '../../data/profile';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i18n = new Translator(locale);
const f = i18n.t.contact;
const accessKey = (import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '').trim();
const hasKey = accessKey.length > 0;
const redirect = new URL(`${i18n.path('/contact/')}?sent=1`, Astro.site).href;
const maxMessage = 3000;

const strings = {
  errors: f.errors,
  send: f.send,
  sending: f.sending
};
---

<div class="message" data-contact>
  <form
    class="form"
    data-contact-form
    data-email={profile.email}
    data-strings={JSON.stringify(strings)}
    method="post"
    action={hasKey ? 'https://api.web3forms.com/submit' : `mailto:${profile.email}`}
    enctype={hasKey ? undefined : 'text/plain'}
    novalidate
  >
    <h2 class="form__title">{f.formTitle}</h2>

    {hasKey && <input type="hidden" name="access_key" value={accessKey} />}
    <input type="hidden" name="from_name" value="bhccob.me portfolio" />
    <input type="hidden" name="redirect" value={redirect} />
    <input class="form__honey" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <div class="form__row">
      <div class="field">
        <label for="contact-name">{f.name}</label>
        <input id="contact-name" name="name" type="text" autocomplete="name" required minlength="2" maxlength="80" placeholder={f.namePlaceholder} aria-describedby="contact-name-error" />
        <p class="field__error" id="contact-name-error" data-error-for="name"></p>
      </div>

      <div class="field">
        <label for="contact-email">{f.email}</label>
        <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="120" placeholder={f.emailPlaceholder} aria-describedby="contact-email-error" />
        <p class="field__error" id="contact-email-error" data-error-for="email"></p>
      </div>
    </div>

    <div class="field">
      <label for="contact-subject">{f.subject} <span class="field__optional">({f.optional})</span></label>
      <input id="contact-subject" name="subject" type="text" maxlength="120" placeholder={f.subjectPlaceholder} />
    </div>

    <div class="field">
      <label for="contact-message">{f.message}</label>
      <textarea id="contact-message" name="message" rows="6" required minlength="10" maxlength={maxMessage} placeholder={f.messagePlaceholder} aria-describedby="contact-message-error contact-message-count"></textarea>
      <div class="field__foot">
        <p class="field__error" id="contact-message-error" data-error-for="message"></p>
        <p class="field__count" id="contact-message-count" data-count data-max={maxMessage}>0 / {maxMessage}</p>
      </div>
    </div>

    <div class="form__actions">
      <button class="btn form__submit" type="submit" data-submit>
        <span data-submit-label>{f.send}</span>
        <span class="form__spinner" aria-hidden="true"></span>
        <svg class="icon" viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" /></svg>
      </button>
      <p class="form__privacy">{f.privacy}</p>
    </div>
    <p class="form__status" role="alert" data-form-status></p>
  </form>

  <div class="form-done" data-form-done hidden tabindex="-1">
    <FlapText text={locale === 'nl' ? 'VERZONDEN' : 'SENT'} label="" play="none" class="form-done__flap" />
    <h2 class="form-done__title" data-done-title data-sent={f.successTitle} data-mailto={f.mailtoTitle}>{f.successTitle}</h2>
    <p class="form-done__text" data-done-text data-sent={f.successText} data-mailto={f.mailtoText}>{f.successText}</p>
    <button class="text-link" type="button" data-form-again>{f.again}</button>
  </div>
</div>

<style>
  .form {
    display: grid;
    gap: 30px;
  }

  .form__title {
    font-size: 15px;
    font-weight: 600;
    color: var(--lilac);
  }

  .form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px 36px;
  }

  .form__honey {
    position: absolute;
    left: -9999px;
  }

  .field {
    display: grid;
    gap: 6px;
  }

  .field label {
    font: 450 11px/1.4 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
    transition: color 0.3s;
  }

  .field:focus-within label {
    color: var(--yellow);
  }

  .field__optional {
    text-transform: none;
    letter-spacing: 0.02em;
  }

  /* fields are lines on the board, not boxes */
  .field input,
  .field textarea {
    width: 100%;
    padding: 10px 0 12px;
    border: 0;
    border-radius: 0;
    background: linear-gradient(var(--yellow), var(--yellow)) left bottom / 0 2px no-repeat,
      linear-gradient(var(--line-strong), var(--line-strong)) left bottom / 100% 1px no-repeat;
    color: var(--paper);
    font-size: 20px;
    caret-color: var(--yellow);
    transition: background-size 0.5s var(--ease-out);
  }

  .field textarea {
    resize: vertical;
    min-height: 150px;
    line-height: 1.5;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    background-size: 100% 2px, 100% 1px;
  }

  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: none;
  }

  .field input[aria-invalid='true'],
  .field textarea[aria-invalid='true'] {
    background: linear-gradient(#ff9d8f, #ff9d8f) left bottom / 100% 2px no-repeat;
  }

  .field__error {
    min-height: 1.2em;
    font-size: 14px;
    color: #ff9d8f;
  }

  .field__foot {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  .field__count {
    font: 450 11px/1.4 var(--font-mono);
    color: var(--dim);
  }

  .form__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }

  .form__privacy {
    font-size: 14px;
    color: var(--dim);
  }

  .form__spinner {
    display: none;
    width: 14px;
    height: 14px;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }

  .form:global(.is-sending) .form__spinner {
    display: inline-block;
  }

  .form:global(.is-sending) .form__submit .icon {
    display: none;
  }

  .form__submit:disabled {
    opacity: 0.75;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .form__status {
    font-size: 15px;
    color: #ff9d8f;
  }

  .form__status:empty {
    display: none;
  }

  .form-done {
    display: grid;
    gap: 18px;
    justify-items: start;
    padding: 12px 0;
  }

  .form-done:focus {
    outline: none;
  }

  .form-done :global(.form-done__flap) {
    --tw: 0.78;
    --th: 1.12;
    --gap: 0.06em;
    font-size: clamp(64px, 8vw, 110px);
  }

  .form-done__title {
    font: 800 36px/1 var(--font-flap);
    text-transform: uppercase;
  }

  .form-done__text {
    color: var(--lilac);
  }

  @media (max-width: 640px) {
    .form__row {
      grid-template-columns: 1fr;
    }
  }
</style>
