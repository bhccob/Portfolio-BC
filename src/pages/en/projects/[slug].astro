---
import ProjectView from '../../../views/ProjectView.astro';
import { projects } from '../../../data/projects';

export function getStaticPaths() {
  return projects.all().map((project) => ({ params: { slug: project.slug } }));
}

const project = projects.bySlug(Astro.params.slug)!;
---

<ProjectView locale="en" project={project} />
