---
import ProjectView from '../../../../views/ProjectView.astro';
import { categories, type CategoryId } from '../../../../data/categories';
import { projects } from '../../../../data/projects';

// A category page opens on the newest project on its shelf.
export function getStaticPaths() {
  return categories.all().map((category) => ({ params: { category: category.id } }));
}

const category = categories.byId(Astro.params.category as CategoryId);
const project = projects.inCategory(category)[0];
---

<ProjectView locale="en" category={category} project={project} />
