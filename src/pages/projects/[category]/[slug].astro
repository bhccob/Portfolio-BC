---
import ProjectView from '../../../views/ProjectView.astro';
import { categories, type CategoryId } from '../../../data/categories';
import { projects } from '../../../data/projects';

// Every other project on a category's shelf gets its own page under that category.
export function getStaticPaths() {
  return categories.all().flatMap((category) =>
    projects
      .inCategory(category)
      .slice(1)
      .map((project) => ({ params: { category: category.id, slug: project.slug } }))
  );
}

const category = categories.byId(Astro.params.category as CategoryId);
const project = projects.bySlug(Astro.params.slug)!;
---

<ProjectView locale="nl" category={category} project={project} />
