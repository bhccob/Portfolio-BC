---
import BenchLayout from '../../layouts/BenchLayout.astro';
import CompassStage from '../../components/compass/CompassStage.astro';
import { Translator } from '../../i18n/Translator';

// A review page for the redesign's compass, kept out of search results until it replaces the home page.
const { t } = new Translator('nl');
---

<BenchLayout locale="nl" route="/lab/compass/" title={t.compass.meta.title} description={t.compass.meta.description} noindex>
  <CompassStage locale="nl" />
</BenchLayout>
