---
import '@fontsource-variable/sofia-sans-extra-condensed';
import '@fontsource-variable/sofia-sans';
import '@fontsource-variable/sofia-sans/wght-italic.css';
import '@fontsource/bagel-fat-one';
import '@fontsource/yellowtail';
import '@fontsource-variable/martian-mono';
import '../styles/tokens.css';
import '../styles/base.css';
// The two faces in the first viewport are preloaded so the hero never swaps fonts.
import displayFont from '@fontsource/bagel-fat-one/files/bagel-fat-one-latin-400-normal.woff2?url';
import scriptFont from '@fontsource/yellowtail/files/yellowtail-latin-400-normal.woff2?url';

import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import LoadingScreen from '../components/ui/LoadingScreen.astro';
import Terminal from '../components/ui/Terminal.astro';
import { Translator, defaultLocale, type Locale } from '../i18n/Translator';
import { profile } from '../data/profile';

interface Props {
  locale: Locale;
  /** Locale-neutral route, e.g. `/` or `/contact/`. */
  route: string;
  title: string;
  description: string;
  ogType?: 'website' | 'article' | 'profile';
  /** Extra JSON-LD objects for this page. */
  structuredData?: Record<string, unknown>[];
  noindex?: boolean;
  page?: 'home' | 'contact' | 'project' | 'error';
  /**
   * Locale-neutral route of the page search engines should index instead,
   * for a page that shows the same content as another (a project listed in
   * a second category points to its primary category).
   */
  canonicalRoute?: string;
  /** Share image for this page (a path under public/), 1200 × 630. */
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  locale,
  route,
  title,
  description,
  ogType = 'website',
  structuredData = [],
  noindex = false,
  page = 'home',
  canonicalRoute,
  ogImage: ogImagePath = '/og.png',
  ogImageAlt = 'Bob Chung, Student Software Engineer in Rotterdam'
} = Astro.props;
const i18n = new Translator(locale);
const site = Astro.site ?? new URL(profile.site);
const alternates = i18n.alternates(canonicalRoute ?? route);
const canonical = new URL(i18n.path(canonicalRoute ?? route), site).href;
const ogImage = new URL(ogImagePath, site).href;
// Cookie-free visitor statistics (Cloudflare Web Analytics), only when a site token is configured.
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const age = profile.ageOn();

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.origin}/#person`,
  name: profile.name,
  givenName: profile.givenName,
  familyName: profile.familyName,
  url: site.origin,
  email: `mailto:${profile.email}`,
  image: new URL('/og.png', site).href,
  jobTitle: 'Student Software Engineer',
  birthPlace: { '@type': 'Place', name: 'Aruba' },
  homeLocation: { '@type': 'Place', name: 'Rotterdam, Netherlands' },
  knowsAbout: ['Web development', 'Game development', 'Godot', 'SQL', 'Databases', 'Laravel', 'JavaScript', 'PHP'],
  sameAs: profile.socials.filter((social) => social.id !== 'email').map((social) => social.url)
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.origin}/#website`,
  url: site.origin,
  name: 'Bob Chung',
  inLanguage: ['en', 'nl'],
  author: { '@id': `${site.origin}/#person` }
};

const graph = [person, website, ...structuredData];
---

<!doctype html>
<html lang={locale} data-page={page}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    {
      !noindex && (
        <>
          <link rel="alternate" hreflang="en" href={new URL(alternates.en, site).href} />
          <link rel="alternate" hreflang="nl" href={new URL(alternates.nl, site).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(alternates[defaultLocale], site).href} />
        </>
      )
    }
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#1c1030" />
    <meta name="color-scheme" content="dark" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={scriptFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Bob Chung" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={i18n.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />

    <!--
      Runs before first paint: flags JS support, decides whether the boot screen
      plays, and blanks the intro tiles so they can flip in (with a failsafe in
      case the main script never runs).
    -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var booted = false;
        try { booted = sessionStorage.getItem('bob-booted') === '1'; } catch (error) {}
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!booted && !reduce) root.classList.add('is-booting');
        if (!reduce) {
          root.classList.add('flap-intro');
          window.setTimeout(function () { root.classList.remove('flap-intro'); }, 4000);
        }
        // Cross-page view transitions are an enhancement; a skipped one is not an error.
        var quiet = function (event) {
          var transition = event.viewTransition;
          if (!transition) return;
          transition.ready.catch(function () {});
          transition.finished.catch(function () {});
        };
        window.addEventListener('pageswap', quiet);
        window.addEventListener('pagereveal', quiet);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{i18n.t.nav.skip}</a>
    <LoadingScreen locale={locale} />
    <div class="blueprint" data-blueprint aria-hidden="true">
      <div class="blueprint__sheet" data-blueprint-sheet></div>
      <div class="blueprint__glow" data-blueprint-glow><div class="blueprint__glow-grid" data-blueprint-glow-grid></div></div>
    </div>
    <div class="grain" aria-hidden="true"></div>
    <Header locale={locale} route={route} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <Terminal locale={locale} age={age} />
    <div class="toast-region" role="status" aria-live="polite" data-toast-region data-strings={JSON.stringify(i18n.t.toast)}></div>
    {analyticsToken && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: analyticsToken })}></script>}
    <script>
      import { bootstrap } from '../scripts/main';
      bootstrap();
    </script>
  </body>
</html>

<style is:global>
  html.flap-intro [data-flap='intro'] .f::before,
  html.flap-intro [data-flap='intro'] .f::after {
    color: transparent;
  }

  /* drawing-paper grid: minor lines every 56px, a stronger line every 224px */
  .blueprint {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .blueprint__sheet {
    position: absolute;
    left: 0;
    right: 0;
    top: -224px;
    height: calc(100% + 448px);
    will-change: transform;
    background-image:
      linear-gradient(rgb(184 170 216 / 0.085) 1px, transparent 1px),
      linear-gradient(90deg, rgb(184 170 216 / 0.085) 1px, transparent 1px),
      linear-gradient(rgb(184 170 216 / 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgb(184 170 216 / 0.04) 1px, transparent 1px);
    background-size: 224px 224px, 224px 224px, 56px 56px, 56px 56px;
  }

  /*
   * The same grid in yellow, seen through a small round window that follows
   * the pointer. The window and the grid inside it only ever move by
   * transform (see BlueprintGrid.ts), so lighting the grid costs no repaints.
   */
  .blueprint__glow {
    position: absolute;
    left: 0;
    top: 0;
    width: 440px;
    height: 440px;
    overflow: hidden;
    -webkit-mask-image: radial-gradient(closest-side, #000 0%, transparent 100%);
    mask-image: radial-gradient(closest-side, #000 0%, transparent 100%);
    opacity: 0;
    transition: opacity 0.5s;
    will-change: transform, opacity;
  }

  .blueprint__glow-grid {
    position: absolute;
    left: 0;
    top: 0;
    width: 664px;
    height: 664px;
    will-change: transform;
    background-image:
      linear-gradient(rgb(255 207 51 / 0.32) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 207 51 / 0.32) 1px, transparent 1px),
      linear-gradient(rgb(255 207 51 / 0.18) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 207 51 / 0.18) 1px, transparent 1px);
    background-size: 224px 224px, 224px 224px, 56px 56px, 56px 56px;
  }

  .blueprint.is-lit .blueprint__glow {
    opacity: 1;
  }

  #main,
  .site-footer {
    position: relative;
    z-index: 1;
  }

  main:focus {
    outline: none;
  }

  .toast-region {
    position: fixed;
    z-index: 95;
    left: 50%;
    bottom: 24px;
    display: grid;
    gap: 8px;
    justify-items: center;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .toast {
    padding: 12px 18px 11px;
    background: var(--yellow);
    color: var(--on-yellow);
    font: 500 12px/1.3 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    border-radius: var(--radius);
    box-shadow: 0 18px 40px -12px rgb(0 0 0 / 0.55);
    animation: toast-in 0.5s var(--ease-out) both;
    transform-origin: top;
  }

  .toast b {
    font-weight: 700;
  }

  .toast.is-leaving {
    animation: toast-out 0.35s var(--ease-in-out) both;
  }

  @keyframes toast-in {
    from {
      opacity: 0;
      transform: perspective(400px) rotateX(-80deg);
    }
  }

  @keyframes toast-out {
    to {
      opacity: 0;
      transform: translateY(10px);
    }
  }
</style>
