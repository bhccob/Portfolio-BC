---
/*
 * The redesign's layout: the same head, SEO and structured data as
 * BaseLayout, with the new type and tokens and none of the current site's
 * furniture (header, boot screen, terminal, blueprint, grain). Its props are
 * BaseLayout's, so a page can move from one to the other unchanged.
 */

// Each package ships its subsets in one CSS file, split by unicode-range, so a
// browser fetches only the Latin faces the copy uses.
import '@fontsource-variable/unbounded';
import '@fontsource-variable/geist';
import '@fontsource-variable/martian-mono';
import '../styles/bench-tokens.css';
import '../styles/bench-base.css';
// The name in the first viewport is set in Unbounded; preloaded so it never swaps fonts.
import titleFont from '@fontsource-variable/unbounded/files/unbounded-latin-wght-normal.woff2?url';

import { Translator, defaultLocale, type Locale } from '../i18n/Translator';
import { profile } from '../data/profile';

interface Props {
  locale: Locale;
  /** Locale-neutral route, e.g. `/` or `/contact/`. */
  route: string;
  title: string;
  description: string;
  ogType?: 'website' | 'article' | 'profile';
  /** Extra JSON-LD objects for this page. */
  structuredData?: Record<string, unknown>[];
  noindex?: boolean;
  page?: 'home' | 'contact' | 'project' | 'error';
  /**
   * Locale-neutral route of the page search engines should index instead,
   * for a page that shows the same content as another.
   */
  canonicalRoute?: string;
  /** Share image for this page (a path under public/), 1200 × 630. */
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  locale,
  route,
  title,
  description,
  ogType = 'website',
  structuredData = [],
  noindex = false,
  page = 'home',
  canonicalRoute,
  ogImage: ogImagePath = '/og.png',
  ogImageAlt = 'Bob Chung, Student Software Engineer in Rotterdam'
} = Astro.props;
const i18n = new Translator(locale);
const site = Astro.site ?? new URL(profile.site);
const alternates = i18n.alternates(canonicalRoute ?? route);
const canonical = new URL(i18n.path(canonicalRoute ?? route), site).href;
const ogImage = new URL(ogImagePath, site).href;
// Cookie-free visitor statistics (Cloudflare Web Analytics), only when a site token is configured.
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.origin}/#person`,
  name: profile.name,
  givenName: profile.givenName,
  familyName: profile.familyName,
  url: site.origin,
  email: `mailto:${profile.email}`,
  image: new URL('/og.png', site).href,
  jobTitle: 'Student Software Engineer',
  birthPlace: { '@type': 'Place', name: 'Aruba' },
  homeLocation: { '@type': 'Place', name: 'Rotterdam, Netherlands' },
  knowsAbout: ['Web development', 'Game development', 'Godot', 'SQL', 'Databases', 'Laravel', 'JavaScript', 'PHP'],
  sameAs: profile.socials.filter((social) => social.id !== 'email').map((social) => social.url)
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.origin}/#website`,
  url: site.origin,
  name: 'Bob Chung',
  inLanguage: ['en', 'nl'],
  author: { '@id': `${site.origin}/#person` }
};

const graph = [person, website, ...structuredData];
---

<!doctype html>
<html lang={locale} data-page={page}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    {
      !noindex && (
        <>
          <link rel="alternate" hreflang="en" href={new URL(alternates.en, site).href} />
          <link rel="alternate" hreflang="nl" href={new URL(alternates.nl, site).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(alternates[defaultLocale], site).href} />
        </>
      )
    }
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#1c1030" />
    <meta name="color-scheme" content="dark" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="preload" href={titleFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Bob Chung" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={i18n.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />

    <!--
      Runs before first paint: flags that scripts run and motion is welcome,
      so the pinned stage lays out from the first frame. Without the flag (no
      scripts, or reduced motion) the page reads as a plain stacked page.
    -->
    <script is:inline>
      (function () {
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('js-motion');
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{i18n.t.nav.skip}</a>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {analyticsToken && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: analyticsToken })}></script>}
    <script>
      import { bootstrap } from '../scripts/bench-main';
      bootstrap();
    </script>
  </body>
</html>
